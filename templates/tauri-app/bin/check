#!/usr/bin/env bash
set -euo pipefail

# Shared checks used by both pre-commit hook and CI.
# Each step is its own script so they can be run individually.
#
# For tauri-app the umbrella covers BOTH halves:
#   * Frontend (root):  prettier --check + eslint + typecheck + unit tests
#   * Rust (src-tauri/): cargo fmt --check + cargo clippy + cargo test
#
# Typecheck has no per-file analogue (tsc / svelte-check operate on
# the project) so it's invoked inline rather than as a separate
# bin/check-typecheck script — matching the existing rust/go/electron
# pattern of "one script per tool, but a single tsc call is the tool".

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

"$SCRIPT_DIR/check-fmt"
"$SCRIPT_DIR/check-lint"

# Typecheck (tsc --noEmit / svelte-check). Skip with a notice if the
# consumer hasn't wired a `typecheck` npm script. Most Tauri projects
# use TypeScript and ship a `typecheck` (or alias one to `check` for
# svelte-check) — see docs/per-stack/tauri-ci.md for the convention.
if [ -f package.json ] && node -e "process.exit(require('./package.json').scripts && require('./package.json').scripts.typecheck ? 0 : 1)" 2>/dev/null; then
    echo "Running typecheck..."
    npm run --silent typecheck
    echo "Typecheck OK"
else
    echo "No 'typecheck' script in package.json — skipping typecheck."
fi

"$SCRIPT_DIR/check-tests"

echo ""
echo "All checks passed!"

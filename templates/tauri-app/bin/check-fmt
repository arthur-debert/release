#!/usr/bin/env bash
set -euo pipefail

# Canonical tauri-app format check. Two halves:
#
#   1. Frontend (root): consumer's `format:check` npm script, or fall
#      back to `npx prettier --check .` if prettier is a dep.
#   2. Rust (src-tauri/): `cargo fmt --all -- --check`.
#
# Skip-with-notice on each side if the relevant tool isn't wired —
# matches the bats Component pattern of "no test infra, no failure".

echo "Checking frontend formatting..."

if [ -f package.json ] && node -e "process.exit(require('./package.json').scripts && require('./package.json').scripts['format:check'] ? 0 : 1)" 2>/dev/null; then
    npm run --silent format:check
elif [ -f package.json ] && node -e "process.exit(require('./package.json').devDependencies && require('./package.json').devDependencies.prettier ? 0 : (require('./package.json').dependencies && require('./package.json').dependencies.prettier ? 0 : 1))" 2>/dev/null; then
    npx --no-install prettier --check .
else
    echo "No 'format:check' script and no prettier dependency — skipping frontend format check."
fi

echo "Frontend formatting OK"

echo "Checking Rust formatting (src-tauri/)..."

if [ -f src-tauri/Cargo.toml ]; then
    (cd src-tauri && cargo fmt --all -- --check)
    echo "Rust formatting OK"
else
    echo "No src-tauri/Cargo.toml — skipping rust format check."
fi

#!/usr/bin/env bash
set -euo pipefail

# Anchor at repo root so `go vet ./...` and `golangci-lint run ./...`
# see the whole module regardless of caller's cwd.
cd "$(cd "$(dirname "$0")/.." && pwd)"

echo "Running go vet..."
go vet ./...

if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint --version
  echo "Running golangci-lint..."
  golangci-lint run ./...
else
  # In CI, a missing linter is a hard failure — otherwise the quality gate
  # silently passes when the action that installs golangci-lint regresses.
  if [ "${CI:-}" = "true" ]; then
    echo "Error: golangci-lint not found in CI environment" >&2
    exit 1
  fi
  echo "golangci-lint not installed — skipping. Install with: brew install golangci-lint"
fi

echo "Lint OK"

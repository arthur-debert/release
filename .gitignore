.DS_Store
*.swp
*.swo
*~

# Canary-fixture build outputs (tests/fixtures/<kind>/ is the authored canary
# seed, #604 — build dirs are ignored, but Cargo.lock is NOT: the canary repo
# tracks its lockfile per the rust-binary fleet convention, and the fixture
# must match the canary's tracked tree exactly so they cannot diverge).
tests/fixtures/*/target/
tests/fixtures/*/dist/
tests/fixtures/*/node_modules/
.antigravitycli/
.claude/scheduled_tasks.lock

# Python workspace (uv). The lock pins orchestrator's SDK tree; treat it as
# non-vendored like orchestrator/ already does. release_gh itself is dep-free.
.venv/
uv.lock
__pycache__/
*.pyc
*.egg-info/
local/

# Python build artifacts (wheels/sdists). Never committed, and never synced
# into a consumer's .release/ tree — a build dir left in the package source
# rides release-sync into consumers and trips their gate (lex#723).
dist/
build/
.pytest_cache/
.ruff_cache/

# Local Doppler CLI state (per-developer/machine; never repo config).
# Created by `doppler` runs in a dev shell — committing it churns per-machine.
dev_shell/

# Staged template bundle (build artifact for the self-contained release_core wheel)
templates/commons/lib/release_core/release_core/_bundled_templates/

# Ephemeral composed build dir (WS4, release#521): `.release/` is gitignored and
# recomposed on demand from the pinned wheel (release-core init), never committed.
# In consumers a self-ignoring `.release/.gitignore` (`*`) handles this; release
# is the source repo and doesn't always materialize the tree, so ignore it here
# explicitly too.
.release/

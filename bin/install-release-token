#!/usr/bin/env python3
# install-release-token — install a release PAT as RELEASE_TOKEN across onboarded repos.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. install-release-token
# is a release-only tool (a real file in bin/, NOT synced to consumers), so realpath
# lands in bin/ and the package sits at ../templates/commons/lib/release_core
# (the contract's variant (b)). Token validation + set-then-verify loop + stdout/exit
# codes match the old bash byte-for-byte.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import install_release_token  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(install_release_token.main(sys.argv[1:]))

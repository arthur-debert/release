#!/usr/bin/env python3
# detect-kind — detect the Kind of a directory by inspecting its filesystem.
#
# Thin shim (shell→Python canary, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. detect-kind is a
# release-only tool (a real file in bin/, NOT synced to consumers), so realpath
# lands in bin/ and the package sits at ../templates/commons/lib/release_core
# (the contract's variant (b)). Output matches the old bash byte-for-byte.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import detect_kind  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(detect_kind.main(sys.argv[1:]))

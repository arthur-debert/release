#!/usr/bin/env bash
# Sweep onboarded repos using the broken gh-dagentic@main reusable
# workflow and migrate them to release/@v1 via per-repo PRs.
#
# Background: the canonical copilot-review.yml template historically
# pointed at arthur-debert/gh-dagentic/.github/workflows/copilot-review.yml@main,
# whose reusable workflow uses GITHUB_TOKEN. GITHUB_TOKEN
# authenticates as github-actions[bot] (Integration actor), and
# Integration actors silently no-op the Copilot review-attach. So
# every consumer pointed at gh-dagentic has had Copilot review
# silently broken since onboarding.
#
# release/@v1 hosts a fixed reusable workflow that requires the
# caller to pass a user PAT (RELEASE_TOKEN) via secrets.
#
# This script:
#   - Auto-discovers consumers whose copilot-review.yml still
#     points at gh-dagentic.
#   - For each, opens a PR replacing it with the canonical
#     templates/rust/workflows/copilot-review.yml from this repo
#     (which references release/@v1 + passes RELEASE_TOKEN).
#
# Usage:
#   migrate-copilot-review                  # sweep all
#   migrate-copilot-review --owners arthur-debert
#   migrate-copilot-review --repos owner/repo,owner/repo2
#   migrate-copilot-review --dry-run        # list, don't PR
#
# The script opens PRs but does NOT merge them. Review and merge
# manually (or with `gh pr merge` in batch). Migration PRs can't
# self-validate Copilot review (their own copilot-review.yml is
# still the broken one until merge), so post-merge smoke testing
# is the proof.

set -uo pipefail

owners="arthur-debert,lex-fmt"
explicit_repos=""
dry_run=0

while [ $# -gt 0 ]; do
  case "$1" in
    --owners)  owners=$2; shift 2 ;;
    --repos)   explicit_repos=$2; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 64 ;;
  esac
done

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
template="$script_dir/../templates/rust/.github/workflows/copilot-review.yml"
[ -f "$template" ] || { echo "error: template not found at $template" >&2; exit 1; }

# Discover broken consumers
echo "scanning for repos still pointing at gh-dagentic..." >&2
broken=()
if [ -n "$explicit_repos" ]; then
  IFS=',' read -ra candidates <<< "$explicit_repos"
else
  candidates=()
  for owner in $(echo "$owners" | tr ',' ' '); do
    while read -r r; do
      candidates+=("$r")
    done < <(gh repo list "$owner" --limit 200 --json nameWithOwner --jq '.[].nameWithOwner')
  done
fi

for r in "${candidates[@]}"; do
  body=$(gh api "repos/$r/contents/.github/workflows/copilot-review.yml" --jq .content 2>/dev/null \
         | base64 -d 2>/dev/null) || continue
  [ -z "$body" ] && continue
  if printf '%s\n' "$body" | grep -q 'arthur-debert/gh-dagentic/.github/workflows/copilot-review.yml@'; then
    broken+=("$r")
  fi
done

if [ ${#broken[@]} -eq 0 ]; then
  echo "no broken consumers found" >&2
  exit 0
fi

echo "found ${#broken[@]} broken consumer(s):" >&2
printf '  %s\n' "${broken[@]}" >&2
echo

if [ "$dry_run" = "1" ]; then
  exit 0
fi

# Process each
workdir_root=$(mktemp -d -t migrate-copilot-XXXXXX)
trap 'rm -rf "$workdir_root"' EXIT

prs_opened=()
prs_failed=()

for repo in "${broken[@]}"; do
  echo "=== $repo ==="
  base=$(gh api "repos/$repo" --jq .default_branch 2>/dev/null)
  if [ -z "$base" ]; then
    echo "  FAIL: could not determine default branch"
    prs_failed+=("$repo: no default branch")
    continue
  fi

  clone_dir="$workdir_root/$(echo "$repo" | tr '/' '_')"
  if ! git clone --depth=1 --branch="$base" "https://github.com/$repo" "$clone_dir" >/dev/null 2>&1; then
    echo "  FAIL: clone failed"
    prs_failed+=("$repo: clone failed")
    continue
  fi

  cp "$template" "$clone_dir/.github/workflows/copilot-review.yml"

  cd "$clone_dir" || { prs_failed+=("$repo: cd failed"); continue; }
  branch="chore/migrate-copilot-review-pointer"
  git checkout -b "$branch" >/dev/null 2>&1

  if git diff --quiet; then
    echo "  SKIP: no changes after copy (already migrated?)"
    cd /
    continue
  fi

  git add .github/workflows/copilot-review.yml
  if ! git -c user.email='migrate-copilot-review@local' -c user.name='migrate-copilot-review' \
       commit -m "ci(copilot-review): migrate from gh-dagentic to release/@v1

The previous reusable workflow at arthur-debert/gh-dagentic/.github/workflows/copilot-review.yml@main
authenticates with GITHUB_TOKEN, which is github-actions[bot]
(Integration actor). Integration actors silently no-op Copilot
review-attach: 'gh pr edit --add-reviewer @copilot' returns the PR
URL with no error but adds nothing.

release/@v1 requires the caller to pass a user PAT via
secrets.gh_token. RELEASE_TOKEN already exists on this repo (or
will once propagated), so wiring it through fixes the silent
failure.

Caught by bin/audit-smoke-test on arthur-debert/dodot — this commit
sweeps the rest." \
       --no-verify >/dev/null 2>&1; then
    echo "  FAIL: commit failed"
    prs_failed+=("$repo: commit failed")
    cd /
    continue
  fi

  if ! git push -u origin "$branch" >/dev/null 2>&1; then
    echo "  FAIL: push failed (possibly branch already exists)"
    prs_failed+=("$repo: push failed")
    cd /
    continue
  fi

  pr_url=$(gh pr create --repo "$repo" --base "$base" --head "$branch" \
    --title "ci(copilot-review): migrate from gh-dagentic to release/@v1" \
    --body "Migrates \`.github/workflows/copilot-review.yml\` from \`arthur-debert/gh-dagentic/.github/workflows/copilot-review.yml@main\` to \`arthur-debert/release/.github/workflows/copilot-review.yml@v1\`.

## Why
The gh-dagentic reusable workflow authenticates with \`GITHUB_TOKEN\`. \`GITHUB_TOKEN\` authenticates as \`github-actions[bot]\` (Integration actor), and Integration actors **silently no-op** the Copilot review-attach. So \`gh pr edit --add-reviewer @copilot\` returned the PR URL with no error, but added nothing.

release/@v1 fixes this by requiring the caller to pass a user PAT (\`RELEASE_TOKEN\`) via \`secrets.gh_token\`.

## Caught by
\`bin/audit-smoke-test\` against arthur-debert/dodot, which opened a real PR and verified the Copilot reviewer did not actually get attached even though the workflow ran successfully. See arthur-debert/release#2.

## Auto-generated
This PR was opened by \`bin/migrate-copilot-review\`. Same change rolling out to all other consumers." 2>&1 | tail -1)
  if printf '%s' "$pr_url" | grep -q 'github.com'; then
    echo "  OK: $pr_url"
    prs_opened+=("$pr_url")
  else
    echo "  FAIL: pr create: $pr_url"
    prs_failed+=("$repo: pr create failed")
  fi

  cd /
done

echo
echo "=== summary ==="
echo "PRs opened: ${#prs_opened[@]}"
printf '  %s\n' "${prs_opened[@]}"
if [ ${#prs_failed[@]} -gt 0 ]; then
  echo
  echo "Failures: ${#prs_failed[@]}"
  printf '  %s\n' "${prs_failed[@]}"
  exit 1
fi
exit 0

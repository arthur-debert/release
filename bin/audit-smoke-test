#!/usr/bin/env python3
# audit-smoke-test — smoke-test the canonical PR loop end-to-end on a real repo.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. audit-smoke-test is
# a release-only tool (a real file in bin/, NOT synced to consumers), so
# realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core (the contract's variant (b)). The PR
# loop verdict + exit codes match the old bash byte-for-byte.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import audit_smoke_test  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(audit_smoke_test.main(sys.argv[1:]))

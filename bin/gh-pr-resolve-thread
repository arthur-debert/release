#!/usr/bin/env bash
# Resolve the PR review thread containing a given comment.
#
# Usage:
#   gh-pr-resolve-thread <pr-number> <comment-id>
#
# Looks up review threads on the PR, finds the one containing the given
# review-comment id (the numeric `id` field returned by `gh api
# repos/.../pulls/<n>/comments`), and resolves it via the GraphQL
# resolveReviewThread mutation.
#
# Why this exists: GitHub PR review threads stay "Unresolved" until
# explicitly marked resolved. Agents that fix or push back on a comment
# but never resolve leave a multi-round PR full of stale-looking open
# threads, which makes it hard to see what's still contested. After
# acting on a comment (fix-and-push OR rationale reply), call this.
#
# Exit codes:
#   0  — thread resolved (or already resolved)
#   1  — thread not found / GraphQL error
#   64 — bad usage
#
# Example:
#   gh-pr-resolve-thread 507 1234567890

# The `$owner`/`$name`/`$pr`/`$threadId` inside the single-quoted
# `gh api graphql -f query='…'` blocks are GraphQL variables, not shell
# expansions — they must stay literal (gh substitutes them from the -F/-f
# flags). SC2016 ("expressions don't expand in single quotes") is a false
# positive for these query bodies. Disable file-wide (must precede the
# first command to apply to the whole file).
# shellcheck disable=SC2016
set -euo pipefail

show_help() { sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; }

case "${1:-}" in
  -h|--help) show_help; exit 0 ;;
  '') show_help >&2; exit 64 ;;
esac

if [ $# -lt 2 ]; then
  echo "error: need <pr-number> <comment-id>" >&2
  show_help >&2
  exit 64
fi

pr=$1
comment_id=$2

[[ "$pr" =~ ^[0-9]+$ ]] || { echo "error: PR number must be numeric (got: $pr)" >&2; exit 64; }
[[ "$comment_id" =~ ^[0-9]+$ ]] || { echo "error: comment id must be numeric (got: $comment_id)" >&2; exit 64; }

repo_owner=$(gh repo view --json owner -q .owner.login)
repo_name=$(gh repo view --json name -q .name)

# Find the thread containing this comment.
thread_json=$(gh api graphql \
  -F owner="$repo_owner" \
  -F name="$repo_name" \
  -F pr="$pr" \
  -f query='
    query($owner: String!, $name: String!, $pr: Int!) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $pr) {
          reviewThreads(first: 100) {
            nodes {
              id
              isResolved
              comments(first: 50) { nodes { databaseId } }
            }
          }
        }
      }
    }')

thread_id=$(jq -r --argjson cid "$comment_id" '
  .data.repository.pullRequest.reviewThreads.nodes[]
  | select(.comments.nodes[] | .databaseId == $cid)
  | .id' <<<"$thread_json" | head -1)

if [ -z "$thread_id" ]; then
  echo "error: no review thread contains comment $comment_id on $repo_owner/$repo_name#$pr" >&2
  exit 1
fi

is_resolved=$(jq -r --arg tid "$thread_id" '
  .data.repository.pullRequest.reviewThreads.nodes[]
  | select(.id == $tid)
  | .isResolved' <<<"$thread_json")

if [ "$is_resolved" = "true" ]; then
  echo "already resolved: thread $thread_id ($repo_owner/$repo_name#$pr)"
  exit 0
fi

gh api graphql \
  -F threadId="$thread_id" \
  -f query='
    mutation($threadId: ID!) {
      resolveReviewThread(input: { threadId: $threadId }) {
        thread { isResolved }
      }
    }' >/dev/null

echo "resolved: thread $thread_id ($repo_owner/$repo_name#$pr, comment $comment_id)"

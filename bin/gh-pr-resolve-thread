#!/usr/bin/env python3
# Resolve the PR review thread containing a given comment.
#
# Usage:
#   gh-pr-resolve-thread <pr-number> <comment-id>
#
# Looks up review threads on the PR, finds the one containing the given
# review-comment id (the numeric `id` field returned by `gh api
# repos/.../pulls/<n>/comments`), and resolves it via the GraphQL
# resolveReviewThread mutation.
#
# Why this exists: GitHub PR review threads stay "Unresolved" until
# explicitly marked resolved. Agents that fix or push back on a comment
# but never resolve leave a multi-round PR full of stale-looking open
# threads, which makes it hard to see what's still contested. After
# acting on a comment (fix-and-push OR rationale reply), call this.
#
# Exit codes:
#   0  — thread resolved (or already resolved)
#   1  — thread not found / GraphQL error
#   64 — bad usage
#
# Example:
#   gh-pr-resolve-thread 507 1234567890
#
# Self-contained, stdlib-only Python (shell→Python port). Network/auth still go through `gh api
# graphql` (so no token plumbing here); the JSON it returns is parsed with
# the stdlib `json` module, so `jq` is no longer required.
"""gh-pr-resolve-thread — resolve the PR review thread containing a comment."""

from __future__ import annotations

import json
import re
import shutil
import subprocess
import sys

USAGE = """\
Resolve the PR review thread containing a given comment.

Usage:
  gh-pr-resolve-thread <pr-number> <comment-id>

Looks up review threads on the PR, finds the one containing the given
review-comment id (the numeric `id` field returned by `gh api
repos/.../pulls/<n>/comments`), and resolves it via the GraphQL
resolveReviewThread mutation.

Exit codes:
  0  — thread resolved (or already resolved)
  1  — thread not found / GraphQL error
  64 — bad usage

Example:
  gh-pr-resolve-thread 507 1234567890
"""

_THREADS_QUERY = """
    query($owner: String!, $name: String!, $pr: Int!) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $pr) {
          reviewThreads(first: 100) {
            nodes {
              id
              isResolved
              comments(first: 50) { nodes { databaseId } }
            }
          }
        }
      }
    }"""

_RESOLVE_MUTATION = """
    mutation($threadId: ID!) {
      resolveReviewThread(input: { threadId: $threadId }) {
        thread { isResolved }
      }
    }"""


def _gh(args: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(["gh", *args], capture_output=True, text=True)


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help"):
        print(USAGE, end="")
        return 0
    if not argv:
        print(USAGE, end="", file=sys.stderr)
        return 64
    if len(argv) < 2:
        print("error: need <pr-number> <comment-id>", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        return 64

    pr, comment_id = argv[0], argv[1]
    if not re.fullmatch(r"[0-9]+", pr):
        print(f"error: PR number must be numeric (got: {pr})", file=sys.stderr)
        return 64
    if not re.fullmatch(r"[0-9]+", comment_id):
        print(f"error: comment id must be numeric (got: {comment_id})", file=sys.stderr)
        return 64

    if shutil.which("gh") is None:
        print("error: gh is required but not found", file=sys.stderr)
        return 1

    cp = _gh(["repo", "view", "--json", "owner,name"])
    if cp.returncode != 0:
        sys.stderr.write(cp.stderr)
        return 1
    try:
        repo = json.loads(cp.stdout)
        owner = repo["owner"]["login"]
        name = repo["name"]
    except (ValueError, KeyError, TypeError):
        print("error: could not parse repo info from gh", file=sys.stderr)
        return 1

    # Find the thread containing this comment.
    cp = _gh(
        [
            "api",
            "graphql",
            "-F",
            f"owner={owner}",
            "-F",
            f"name={name}",
            "-F",
            f"pr={pr}",
            "-f",
            f"query={_THREADS_QUERY}",
        ]
    )
    if cp.returncode != 0:
        sys.stderr.write(cp.stderr)
        return 1

    try:
        data = json.loads(cp.stdout)
        repository = data.get("data", {}).get("repository") or {}
        pull_request = repository.get("pullRequest") or {}
        nodes = pull_request.get("reviewThreads", {}).get("nodes") or []
    except (ValueError, AttributeError, TypeError):
        print("error: could not parse review threads from gh", file=sys.stderr)
        return 1

    cid = int(comment_id)
    thread = next(
        (
            t
            for t in nodes
            if any(c.get("databaseId") == cid for c in t.get("comments", {}).get("nodes", []))
        ),
        None,
    )

    if thread is None:
        print(
            f"error: no review thread contains comment {comment_id} on {owner}/{name}#{pr}",
            file=sys.stderr,
        )
        return 1

    thread_id = thread.get("id")
    if thread.get("isResolved") is True:
        print(f"already resolved: thread {thread_id} ({owner}/{name}#{pr})")
        return 0

    cp = _gh(["api", "graphql", "-F", f"threadId={thread_id}", "-f", f"query={_RESOLVE_MUTATION}"])
    if cp.returncode != 0:
        sys.stderr.write(cp.stderr)
        return 1

    print(f"resolved: thread {thread_id} ({owner}/{name}#{pr}, comment {comment_id})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

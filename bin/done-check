#!/usr/bin/env bash
# done-check — fleet-enforcement gate for the "pilot-running" state contract.
#
# Per release/ README §States — the contract: a (Stack, Repo) combo is
# *pilot-running* when every applicable verb's local entry point + CI run
# is green AND the most recent release was cut by the canonical
# `<stack>.yml@v1` workflow. The adoption matrix (README) is hand-curated
# today, easy to drift; this tool replaces that with a programmatic
# read of GitHub state.
#
# Usage:
#   done-check                       # current git/gh repo
#   done-check --repo owner/name
#   done-check --json                # machine-readable
#   done-check --quiet               # only print failing rows
#
# Exit codes:
#   0   — pilot-running (every applicable verb is PASS)
#   1   — not pilot-running (one or more verbs are FAIL or missing)
#   2   — only WARN rows (e.g. release column unverified because the
#         consumer has no releases yet — not a hard fail for new repos)
#   64  — bad usage
#   65  — could not detect stack
#
# What it checks per applicable verb:
#   L = local: `bin/<verb>` exists on default branch (the file IS the
#       wiring signal; +x and actual exec are CI's job to gate, not
#       done-check's — keep this fast enough to sweep a fleet from
#       a single host)
#   C = CI:    most recent default-branch run of the consumer's CI
#       workflow (`ci.yml` by convention) succeeded
#   release = the most recent GH release's creating workflow run came
#       from `<stack>.yml@v1` (not a bespoke release.yml)
#
# What's deliberately out of scope:
#   - actually executing `bin/<verb>` (too heavy for fleet sweeps; CI
#     gates this for real on every PR)
#   - the "e2e (L/C)" column for stacks without an e2e flow
#   - per-component checks (audit-repo covers those)

set -euo pipefail

repo=""
json_mode=0
quiet=0

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)   repo=$2; shift 2 ;;
    --json)   json_mode=1; shift ;;
    --quiet)  quiet=1; shift ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 64 ;;
  esac
done

if [ -z "$repo" ]; then
  repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || {
    echo "could not detect repo (pass --repo owner/name)" >&2
    exit 64
  }
fi

# ------------------------------------------------------------------
# Stack detection.
#
# Primary signal: read the consumer's `.github/workflows/release.yml`
# and grep the `uses:` line for `arthur-debert/release/.github/
# workflows/<NAME>.yml@`. Map NAME back to the stack. This is far
# more reliable than filesystem heuristics because the release.yml
# is what done-check actually cares about (is this consumer wired
# to canonical?).
#
# Fallback: filesystem heuristics for consumers without a
# canonical-shaped release.yml.
# ------------------------------------------------------------------
workflow_to_stack() {
  case "$1" in
    rust-cli.yml)      echo rust-cli ;;
    rust-lib.yml)      echo rust-lib ;;
    electron-app.yml)  echo electron-app ;;
    tauri-app.yml)     echo tauri-app ;;
    vscode-ext.yml)    echo vsce-ext ;;
    nvim-plugin.yml)   echo nvim-plugin ;;
    tree-sitter.yml)   echo tree-sitter ;;
    zed-extension.yml) echo zed-extension ;;
    go-cli.yml)        echo go-cli ;;
    gh-action.yml)     echo gh-action ;;
    *) return 1 ;;
  esac
}

detect_stack_remote() {
  local r=$1

  # Primary: release.yml uses-line. `Accept: application/vnd.github.raw`
  # returns the file body directly — no base64 round-trip, and no
  # macOS/linux `base64 -d` vs `-D` portability gotcha.
  local rel_yml
  rel_yml=$(gh api "repos/$r/contents/.github/workflows/release.yml" \
    -H 'Accept: application/vnd.github.raw' 2>/dev/null) || rel_yml=""
  if [ -n "$rel_yml" ]; then
    local wf_name
    # `|| true` on the pipeline: with `set -euo pipefail`, a no-match
    # grep exits 1 and pipefail propagates — `|| true` lets a missing
    # canonical uses-line fall through to the self-call lookup below
    # (or eventually the filesystem fallback).
    wf_name=$(printf '%s\n' "$rel_yml" \
      | grep -oE 'arthur-debert/release/\.github/workflows/[a-z-]+\.yml' \
      | head -1 \
      | sed -E 's|.*/||' || true)
    if [ -z "$wf_name" ]; then
      # self-call (release/'s own release.yml uses ./.github/workflows/gh-action.yml)
      wf_name=$(printf '%s\n' "$rel_yml" \
        | grep -oE '\./\.github/workflows/[a-z-]+\.yml' \
        | head -1 \
        | sed -E 's|.*/||' || true)
    fi
    if [ -n "$wf_name" ]; then
      local stack
      if stack=$(workflow_to_stack "$wf_name"); then
        echo "$stack"; return 0
      fi
    fi
  fi

  # Fallback: filesystem heuristics (matches bin/detect-stack).
  # `--paginate` ensures we see every file in repos with a large root
  # listing (default page is 100 entries).
  local contents
  contents=$(gh api --paginate "repos/$r/contents" --jq '.[] | .name' 2>/dev/null) || {
    echo "could not read repo contents (auth? rate limit?)" >&2
    return 1
  }
  if printf '%s\n' "$contents" | grep -qxE 'Formula|Casks'; then
    echo brew-tap; return 0
  fi
  if printf '%s\n' "$contents" | grep -qx 'grammar.js'; then
    echo tree-sitter; return 0
  fi
  if gh api "repos/$r/contents/src-tauri/Cargo.toml" >/dev/null 2>&1 \
     && printf '%s\n' "$contents" | grep -qx 'package.json'; then
    echo tauri-app; return 0
  fi
  if printf '%s\n' "$contents" | grep -qx 'extension.toml' \
     && printf '%s\n' "$contents" | grep -qx 'Cargo.toml'; then
    echo zed-extension; return 0
  fi
  if printf '%s\n' "$contents" | grep -qx 'package.json'; then
    local pkg
    pkg=$(gh api "repos/$r/contents/package.json" \
      -H 'Accept: application/vnd.github.raw' 2>/dev/null) || pkg=""
    if printf '%s\n' "$pkg" | grep -qE '"electron"|"electron-builder"'; then
      echo electron-app; return 0
    fi
    if printf '%s\n' "$pkg" | grep -qE '"@vscode/vsce"|"vsce"'; then
      echo vsce-ext; return 0
    fi
  fi
  if printf '%s\n' "$contents" | grep -qx 'Cargo.toml'; then
    # Without release.yml to disambiguate, default to rust-lib (safer:
    # rust-cli will get the discriminator from its release.yml above).
    echo rust-lib; return 0
  fi
  if printf '%s\n' "$contents" | grep -qx 'go.mod'; then
    echo go-cli; return 0
  fi
  if printf '%s\n' "$contents" | grep -qxE 'lua|plugin'; then
    echo nvim-plugin; return 0
  fi
  if printf '%s\n' "$contents" | grep -qxE 'action\.yml|action\.yaml'; then
    echo gh-action; return 0
  fi
  return 1
}

# ------------------------------------------------------------------
# Stack → applicable verbs + canonical workflow filename.
# Hardcoded for v1 — once templates/<stack>/manifest.yaml grows a
# `verbs:` key + `release-workflow:`, switch to reading that.
# ------------------------------------------------------------------
verbs_for_stack() {
  case "$1" in
    rust-cli)        echo "check build release" ;;
    rust-lib)        echo "check build release" ;;
    electron-app)    echo "check build release e2e" ;;
    tauri-app)       echo "check build release e2e" ;;
    vsce-ext)        echo "check build release" ;;
    nvim-plugin)     echo "check release" ;;
    tree-sitter)     echo "check build release" ;;
    zed-extension)   echo "check build release" ;;
    go-cli)          echo "check build release" ;;
    gh-action)       echo "check release" ;;
    brew-tap)        echo "" ;;  # out-of-scope per #175
    *)               return 1 ;;
  esac
}

release_workflow_for_stack() {
  case "$1" in
    rust-cli)        echo "rust-cli.yml" ;;
    rust-lib)        echo "rust-lib.yml" ;;
    electron-app)    echo "electron-app.yml" ;;
    tauri-app)       echo "tauri-app.yml" ;;
    vsce-ext)        echo "vscode-ext.yml" ;;
    nvim-plugin)     echo "nvim-plugin.yml" ;;
    tree-sitter)     echo "tree-sitter.yml" ;;
    zed-extension)   echo "zed-extension.yml" ;;
    go-cli)          echo "go-cli.yml" ;;
    gh-action)       echo "gh-action.yml" ;;
    *)               return 1 ;;
  esac
}

# ------------------------------------------------------------------
# Result accumulator + emitter.
# ------------------------------------------------------------------
results=()    # PASS/FAIL/WARN|verb|local|ci|msg
record() {
  results+=("$1|$2|$3|$4|$5")
}

# ------------------------------------------------------------------
# Check: bin/<verb> exists on default branch.
# The +x bit and actual exec are CI's gate; done-check verifies the
# canonical wiring is in place (file is there at the expected path).
# ------------------------------------------------------------------
check_local() {
  local r=$1 verb=$2
  if gh api "repos/$r/contents/bin/$verb" >/dev/null 2>&1; then
    echo "PASS|bin/$verb"
  else
    echo "FAIL|bin/$verb missing"
  fi
}

# ------------------------------------------------------------------
# Check: most recent CI run on consumer's ci.yml on default branch.
# Some consumers still name their CI workflow test.yml; check both.
# ------------------------------------------------------------------
check_ci() {
  local r=$1
  local default_branch
  default_branch=$(gh api "repos/$r" --jq '.default_branch // empty' 2>/dev/null) || default_branch=""
  [ -z "$default_branch" ] && default_branch=main
  for wf in ci.yml test.yml; do
    # Pull last 10 runs and pick the most recent COMPLETED one — the
    # very latest may be queued/in-progress, which would otherwise
    # produce a misleading "ci last run = (empty)" verdict.
    local runs
    runs=$(gh api "repos/$r/actions/workflows/$wf/runs?branch=$default_branch&event=push&per_page=10" 2>/dev/null) || continue
    local total
    total=$(printf '%s' "$runs" | jq -r '.total_count // 0')
    [ "$total" = "0" ] && continue
    local conclusion
    conclusion=$(printf '%s' "$runs" \
      | jq -r '[.workflow_runs[] | select(.status == "completed")][0].conclusion // empty')
    if [ -z "$conclusion" ]; then
      echo "WARN|$wf has runs but none completed (all queued/in-progress)"; return
    fi
    if [ "$conclusion" = "success" ]; then
      echo "PASS|$wf"; return
    fi
    echo "FAIL|$wf last completed run = $conclusion"; return
  done
  echo "WARN|no ci.yml or test.yml runs found on $default_branch"
}

# ------------------------------------------------------------------
# Check: latest release was cut by <stack>.yml@v1 (the canonical).
# Strategy:
#   1. gh release list --limit 1 → tag
#   2. Find the workflow run whose head_sha matches the tag's SHA AND
#      whose workflow path is .github/workflows/release.yml
#   3. Read the consumer's release.yml on the tag's SHA + grep for
#      `uses: arthur-debert/release/.github/workflows/<stack>.yml@`
# ------------------------------------------------------------------
check_release() {
  local r=$1 stack=$2
  local stack_wf
  stack_wf=$(release_workflow_for_stack "$stack") || { echo "SKIP|stack has no release workflow"; return; }

  # Prefer releases/latest (the GH-marked "Latest release") over
  # `releases?per_page=1` (most-recently-CREATED, can be a prior
  # release re-published). releases/latest skips drafts + prereleases
  # automatically.
  local latest_tag
  latest_tag=$(gh api "repos/$r/releases/latest" --jq .tag_name 2>/dev/null) || latest_tag=""
  if [ -z "$latest_tag" ]; then
    # Fallback for repos that have only prereleases (no non-prerelease
    # has ever been marked "latest").
    latest_tag=$(gh api "repos/$r/releases?per_page=1" --jq '.[0].tag_name // empty' 2>/dev/null)
  fi
  if [ -z "$latest_tag" ]; then
    echo "WARN|no releases — consumer has not shipped through canonical yet"
    return
  fi

  # Read release.yml at the tag's SHA — if it's a thin caller of
  # <stack>.yml@vN, the release we're looking at came from canonical.
  local rel_yml
  rel_yml=$(gh api "repos/$r/contents/.github/workflows/release.yml?ref=$latest_tag" \
    -H 'Accept: application/vnd.github.raw' 2>/dev/null) || rel_yml=""
  if [ -z "$rel_yml" ]; then
    echo "FAIL|no release.yml at tag $latest_tag (release source unknown)"
    return
  fi

  # Escape dots in the workflow filename — without escaping, the `.`
  # inside e.g. `rust-cli.yml` would be a regex wildcard and falsely
  # match `rust-clixyml`.
  local stack_wf_re=${stack_wf//./\\.}
  if printf '%s\n' "$rel_yml" | grep -qE "uses:[[:space:]]+arthur-debert/release/\.github/workflows/${stack_wf_re}@"; then
    echo "PASS|$latest_tag via $stack_wf"
  else
    # Special case: release/ itself's release.yml uses gh-action.yml@v1
    # via its OWN reusable workflow — still counts as canonical.
    if printf '%s\n' "$rel_yml" | grep -qE "uses:[[:space:]]+\./\.github/workflows/${stack_wf_re}"; then
      echo "PASS|$latest_tag via self-call $stack_wf"
    else
      echo "FAIL|$latest_tag was NOT cut by ${stack_wf}@v1 (release.yml is bespoke)"
    fi
  fi
}

# ------------------------------------------------------------------
# Main
# ------------------------------------------------------------------
echo "Detecting stack for $repo..."
stack=$(detect_stack_remote "$repo") || { echo "could not detect stack" >&2; exit 65; }
echo "Stack: $stack"

if [ "$stack" = "brew-tap" ]; then
  echo "brew-tap is explicitly out-of-scope (passive registry; no release semantics — see #175)"
  if [ "$json_mode" = 1 ]; then
    printf '{"repo":"%s","stack":"%s","state":"out-of-scope","verbs":[]}\n' "$repo" "$stack"
  fi
  exit 0
fi

applicable_verbs=$(verbs_for_stack "$stack") || { echo "no verbs registered for stack=$stack" >&2; exit 1; }

# Cache one CI lookup — same answer for every non-release verb.
ci_result=$(check_ci "$repo")

any_fail=0
any_warn=0

for verb in $applicable_verbs; do
  local_result=$(check_local "$repo" "$verb")
  local_state=${local_result%%|*}
  local_msg=${local_result#*|}

  if [ "$verb" = "release" ]; then
    rel=$(check_release "$repo" "$stack")
    rel_state=${rel%%|*}
    rel_msg=${rel#*|}
    record "$rel_state" "$verb" "$local_state" "(n/a)" "$rel_msg [local: $local_msg]"
    [ "$rel_state" = "FAIL" ] && any_fail=1
    [ "$rel_state" = "WARN" ] && any_warn=1
  else
    ci_state=${ci_result%%|*}
    ci_msg=${ci_result#*|}
    if [ "$local_state" = "PASS" ] && [ "$ci_state" = "PASS" ]; then
      record PASS "$verb" "$local_state" "$ci_state" "ok"
    elif [ "$local_state" = "FAIL" ] || [ "$ci_state" = "FAIL" ]; then
      record FAIL "$verb" "$local_state" "$ci_state" "local: $local_msg; ci: $ci_msg"
      any_fail=1
    else
      record WARN "$verb" "$local_state" "$ci_state" "local: $local_msg; ci: $ci_msg"
      any_warn=1
    fi
  fi
done

# ------------------------------------------------------------------
# Emit
# ------------------------------------------------------------------
overall_state="pilot-running"
if [ "$any_fail" = 1 ]; then
  overall_state="implemented"
elif [ "$any_warn" = 1 ]; then
  overall_state="implemented+warnings"
fi

if [ "$json_mode" = 1 ]; then
  # Build a JSON object with verbs[] array.
  printf '{"repo":"%s","stack":"%s","state":"%s","verbs":[' "$repo" "$stack" "$overall_state"
  first=1
  for row in "${results[@]}"; do
    IFS='|' read -r state verb localv ci msg <<<"$row"
    [ "$first" = 0 ] && printf ','
    printf '{"verb":"%s","state":"%s","local":"%s","ci":"%s","msg":%s}' \
      "$verb" "$state" "$localv" "$ci" "$(jq -Rn --arg s "$msg" '$s')"
    first=0
  done
  printf ']}\n'
else
  # Human-readable table matching #164's per-stack sub-issue format.
  printf '\n| Verb    | local | CI    | result | notes                                                 |\n'
  printf '|---------|-------|-------|--------|-------------------------------------------------------|\n'
  for row in "${results[@]}"; do
    IFS='|' read -r state verb localv ci msg <<<"$row"
    if [ "$quiet" = 1 ] && [ "$state" = "PASS" ]; then
      continue
    fi
    printf '| %-7s | %-5s | %-5s | %-6s | %s\n' "$verb" "$localv" "$ci" "$state" "$msg"
  done
  printf '\n→ %s/%s : %s\n\n' "$repo" "$stack" "$overall_state"
fi

# ------------------------------------------------------------------
# Exit code policy.
# ------------------------------------------------------------------
if [ "$any_fail" = 1 ]; then
  exit 1
elif [ "$any_warn" = 1 ]; then
  exit 2
else
  exit 0
fi

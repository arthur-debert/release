#!/usr/bin/env python3
# done-check — fleet-enforcement gate for the "pilot-running" state contract.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. done-check is a
# release-only tool (a real file in bin/, NOT synced to consumers), so realpath
# lands in bin/ and the package sits at ../templates/commons/lib/release_core
# (the contract's variant (b)). Stdout (the table + --json object) and the
# exit-code policy match the old bash byte-for-byte.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import done_check  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(done_check.main(sys.argv[1:]))

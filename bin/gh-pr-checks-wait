#!/usr/bin/env bash
# Wait for all checks on a PR to complete.
#
# Usage:
#   gh-pr-checks-wait <pr-number> [extra gh args...]
#
# Thin shim around `gh pr checks --watch --interval 30` for naming
# symmetry with gh-copilot-wait. Polls every 30s. Any extra arguments
# are forwarded to `gh pr checks` (e.g. `--required` to filter).
#
# Exit codes:
#   0  — all checks passed
#   1  — one or more checks failed
#   64 — bad usage
#
# Example:
#   gh-pr-checks-wait 91
#   gh-pr-checks-wait 91 --required

set -euo pipefail

show_help() { sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; }

case "${1:-}" in
  -h|--help) show_help; exit 0 ;;
  '') show_help >&2; exit 64 ;;
esac

pr=$1; shift
[[ "$pr" =~ ^[0-9]+$ ]] || { echo "error: PR number must be numeric (got: $pr)" >&2; exit 64; }

exec gh pr checks "$pr" --watch --interval 30 "$@"

#!/usr/bin/env python3
# Print the latest Copilot review + ALL review threads on a PR. Read-only.
#
# Usage:
#   gh-copilot-show <pr-number>
#
# Fetches and prints whatever Copilot review is ALREADY posted, plus every
# review thread on the PR, via `gh api`. It does NOT request a review and does
# NOT wait — use this when you just want to READ. To request a fresh review
# and block until it lands, use gh-copilot-review (the composite: on + wait +
# show).
#
# Threads come from GraphQL `reviewThreads` — the source of truth for inline
# comments. The old REST `/pulls/{n}/comments` fetch surfaced only a subset
# (3 of 6 on release#502) and its exact author match
# (`copilot-pull-request-reviewer[bot]`) missed comments whose author renders
# as `Copilot` (release#455, #515). Threads are listed for EVERY author
# (Copilot, second bots like CodeRabbit/Gemini, humans): thread accounting is
# reviewer-agnostic — an unresolved thread blocks the done-signal no matter
# who opened it.
#
# Prints nothing under the review header when no Copilot review exists yet;
# exits 0 regardless (absence is not an error — poll with gh-copilot-wait if
# you need to block for one).
#
# Output:
#   - "=== copilot review on <repo>#<pr> ===" — review state + body
#   - "=== review threads ===" — every thread: [open|resolved] file:line,
#     author + thread/comment ids (handles for gh-pr-resolve-thread), bodies
#
# Exit codes:
#   0  — printed (even if no review is present yet)
#   1  — gh failure
#   64 — bad usage
#
# Example:
#   gh-copilot-show 91
"""gh-copilot-show — print the Copilot review + all review threads on a PR."""

from __future__ import annotations

import json
import re
import shutil
import subprocess
import sys

USAGE = """\
Print the latest Copilot review + ALL review threads on a PR. Read-only.

Usage:
  gh-copilot-show <pr-number>

Threads come from GraphQL reviewThreads (the source of truth for inline
comments) and are listed for EVERY author — Copilot, second bots, humans —
with their resolution state and the thread/comment ids that
gh-pr-resolve-thread needs.

Exit codes:
  0  — printed (even if no review is present yet)
  1  — gh failure
  64 — bad usage

Example:
  gh-copilot-show 91
"""

_THREADS_QUERY = """
    query($owner: String!, $name: String!, $pr: Int!, $cursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $pr) {
          reviewThreads(first: 100, after: $cursor) {
            pageInfo { hasNextPage endCursor }
            nodes {
              id
              isResolved
              comments(first: 100) {
                nodes { databaseId path line originalLine body author { login } }
              }
            }
          }
        }
      }
    }"""


def _gh(args: list[str]) -> str:
    proc = subprocess.run(["gh", *args], capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        raise SystemExit(1)
    return proc.stdout


def _is_copilot(login: str) -> bool:
    # Tolerant of GitHub's login variants: `copilot-pull-request-reviewer[bot]`
    # on reviews, `Copilot` / `copilot-pull-request-reviewer` on comments.
    return "copilot" in login.lower()


def _review_threads(owner: str, name: str, pr: str) -> list[dict]:
    """Every review-thread node, following the cursor (a dropped page could
    hide an unresolved thread)."""
    nodes: list[dict] = []
    cursor: str | None = None
    while True:
        args = [
            "api",
            "graphql",
            "-F",
            f"owner={owner}",
            "-F",
            f"name={name}",
            "-F",
            f"pr={pr}",
            "-f",
            f"query={_THREADS_QUERY}",
        ]
        if cursor is not None:
            args += ["-f", f"cursor={cursor}"]
        data = json.loads(_gh(args))
        conn = data["data"]["repository"]["pullRequest"]["reviewThreads"]
        nodes.extend(conn["nodes"])
        page = conn["pageInfo"]
        if not page["hasNextPage"]:
            return nodes
        cursor = page["endCursor"]


def _print_copilot_reviews(owner: str, name: str, pr: str) -> None:
    reviews = json.loads(_gh(["api", "--paginate", f"repos/{owner}/{name}/pulls/{pr}/reviews"]))
    for r in reviews:
        if not _is_copilot((r.get("user") or {}).get("login", "")):
            continue
        print()
        print(f"state: {r.get('state', '')}")
        print(f"submitted: {r.get('submitted_at', '')}")
        print()
        print(r.get("body") or "")
        print()


def _print_threads(threads: list[dict]) -> None:
    for t in threads:
        comments = (t.get("comments") or {}).get("nodes") or []
        root = comments[0] if comments else {}
        marker = "resolved" if t.get("isResolved") else "open"
        path = root.get("path") or "?"
        line = root.get("line") or root.get("originalLine") or "?"
        print(f"[{marker}] {path}:{line} (thread {t.get('id')})")
        for c in comments:
            author = (c.get("author") or {}).get("login", "?")
            print(f"  [{c.get('databaseId')}] {author}: {c.get('body') or ''}")
        print()


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help"):
        print(USAGE, end="")
        return 0
    if not argv:
        print(USAGE, end="", file=sys.stderr)
        return 64
    pr = argv[0]
    if not re.fullmatch(r"[0-9]+", pr):
        print(f"error: PR number must be numeric (got: {pr})", file=sys.stderr)
        return 64
    if shutil.which("gh") is None:
        print("error: gh is required but not found", file=sys.stderr)
        return 1

    repo = json.loads(_gh(["repo", "view", "--json", "owner,name"]))
    owner, name = repo["owner"]["login"], repo["name"]

    print()
    print(f"=== copilot review on {owner}/{name}#{pr} ===")
    _print_copilot_reviews(owner, name, pr)

    print("=== review threads ===")
    _print_threads(_review_threads(owner, name, pr))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

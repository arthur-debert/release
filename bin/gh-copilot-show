#!/usr/bin/env bash
# Print the latest Copilot review + inline comments on a PR. Read-only.
#
# Usage:
#   gh-copilot-show <pr-number>
#
# Fetches and prints whatever Copilot review/comments are ALREADY posted, via
# `gh api`. It does NOT request a review and does NOT wait — use this when you
# just want to READ an existing review. To request a fresh review and block
# until it lands, use gh-copilot-review (the composite: on + wait + show).
#
# Prints nothing under the headers when no Copilot review exists yet; exits 0
# regardless (absence is not an error — poll with gh-copilot-wait if you need to
# block for one).
#
# Output:
#   - "=== copilot review on <repo>#<pr> ===" — review state + body
#   - "=== inline comments ===" — file:line + comment body, one per line
#
# Exit codes:
#   0  — printed (even if no review is present yet)
#   64 — bad usage
#
# Example:
#   gh-copilot-show 91

set -euo pipefail

show_help() { sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; }

case "${1:-}" in
  -h|--help) show_help; exit 0 ;;
  '') show_help >&2; exit 64 ;;
esac

pr=$1
[[ "$pr" =~ ^[0-9]+$ ]] || { echo "error: PR number must be numeric (got: $pr)" >&2; exit 64; }

repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)

echo
echo "=== copilot review on $repo#$pr ==="
gh api "repos/{owner}/{repo}/pulls/$pr/reviews" \
  --jq '.[] | select(.user.login == "copilot-pull-request-reviewer[bot]") | "\nstate: \(.state)\nsubmitted: \(.submitted_at)\n\n\(.body)\n"'

echo "=== inline comments ==="
gh api --paginate "repos/{owner}/{repo}/pulls/$pr/comments" \
  --jq '.[] | select(.user.login == "copilot-pull-request-reviewer[bot]") | "[\(.path):\(.line // .original_line // "?")] \(.body)\n"'

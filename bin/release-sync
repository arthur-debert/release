#!/usr/bin/env bash
# Sync managed files from the release repo into the current consumer repo
# using the build-directory + symlinks model (ADR-0001).
#
# Usage:
#   release-sync            # rebuild .release/ and symlinks
#   release-sync --check    # exit non-zero if anything would change
#   release-sync --dry-run  # show what would happen, write nothing
#   release-sync --migrate  # remove real files at managed locations
#                                # before creating symlinks (for adopting
#                                # the new sync model on a repo that has
#                                # files from the old sync as real files)
#
# How it works:
#   1. Detect Kind via detect-kind
#   2. Resolve Capabilities (Kind manifest + consumer .release-sync.yaml)
#   3. Materialize ALL managed files into .release/ from scratch
#   4. For each file in .release/, ensure a relative symlink exists at
#      the expected consumer location (path-mirror: strip template prefix)
#   5. Walk the repo for broken symlinks pointing into .release/ and
#      delete them
#
# No state file. The filesystem is the state. Removals propagate
# automatically because .release/ is rebuilt from scratch.
#
# Source ref selection (first match wins):
#   $RELEASE_REF if set
#   origin/release/beta/<consumer-repo-name>
#   origin/release/beta/<kind>
#   origin/main
#
# Exit codes:
#   0  — clean (sync mode: rebuilt; check mode: no changes needed)
#   1  — changes detected (--check only) or fatal error
#   64 — bad usage

set -euo pipefail

show_help() { sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; }

mode=sync
migrate=0
while [ $# -gt 0 ]; do
  case "$1" in
    --check) mode=check; shift ;;
    --dry-run) mode=dryrun; shift ;;
    --migrate) migrate=1; shift ;;
    -h|--help) show_help; exit 0 ;;
    *) echo "unknown arg: $1" >&2; show_help >&2; exit 64 ;;
  esac
done

RELEASE_HOME=${RELEASE_HOME:-$HOME/release}
if [ ! -d "$RELEASE_HOME/.git" ]; then
  echo "release-sync: \$RELEASE_HOME='$RELEASE_HOME' is not a git clone" >&2
  exit 1
fi
command -v yq >/dev/null || {
  echo "release-sync: yq is required (mikefarah/yq v4)." >&2
  exit 1
}

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "release-sync: not inside a git repo" >&2; exit 1; }
cd "$repo_root"

release_real=$(cd "$RELEASE_HOME" && pwd -P)
repo_real=$(pwd -P)
if [ "$release_real" = "$repo_real" ]; then
  echo "release-sync: refusing to run inside \$RELEASE_HOME" >&2
  exit 1
fi

repo_name=$(basename "$repo_root")
kind=$(detect-kind)

# --- Ref selection -------------------------------------------------------

ref=""
if [ -n "${RELEASE_REF:-}" ]; then
  if ! git -C "$RELEASE_HOME" rev-parse --verify --quiet "$RELEASE_REF" >/dev/null; then
    echo "release-sync: \$RELEASE_REF='$RELEASE_REF' is not a valid ref" >&2
    exit 1
  fi
  ref=$RELEASE_REF
else
  git -C "$RELEASE_HOME" fetch --quiet --prune origin
  for candidate in "release/beta/$repo_name" "release/beta/$kind" main; do
    if git -C "$RELEASE_HOME" rev-parse --verify --quiet \
         "refs/remotes/origin/$candidate" >/dev/null; then
      ref="origin/$candidate"
      break
    fi
  done
  if [ -z "$ref" ]; then
    echo "release-sync: no candidate branch found in \$RELEASE_HOME" >&2
    exit 1
  fi
fi

ref_sha=$(git -C "$RELEASE_HOME" rev-parse "$ref")

if ! git -C "$RELEASE_HOME" ls-tree -d --name-only "$ref" -- "templates/$kind" \
     | grep -q .; then
  echo "release-sync: ref '$ref' has no templates/$kind/ tree" >&2
  exit 1
fi

# --- Capability resolution ----------------------------------------------

# --migrate: rewrite legacy `components:` field to `capabilities:` if the
# consumer's .release-sync.yaml still uses the pre-rename name.
if [ "$migrate" = 1 ] && [ "$mode" = sync ] && [ -f .release-sync.yaml ]; then
  if yq -e '.components' .release-sync.yaml >/dev/null 2>&1 && ! yq -e '.capabilities' .release-sync.yaml >/dev/null 2>&1; then
    echo "migrating .release-sync.yaml: components: -> capabilities:" >&2
    yq -i '.capabilities = .components | del(.components)' .release-sync.yaml
  fi
fi

declare -a capabilities=()
if [ -f .release-sync.yaml ]; then
  manifest_source=".release-sync.yaml (consumer override)"
  mapfile -t capabilities < <(yq '.capabilities // [] | .[]' .release-sync.yaml)
elif git -C "$RELEASE_HOME" cat-file -e "$ref:templates/$kind/manifest.yaml" 2>/dev/null; then
  manifest_source="templates/$kind/manifest.yaml (Kind default)"
  mapfile -t capabilities < <(git -C "$RELEASE_HOME" show "$ref:templates/$kind/manifest.yaml" | yq '.capabilities // [] | .[]')
else
  # Manifest-less Kind (e.g. tree-sitter, render). No capabilities are
  # declared, but the consumer still gets templates/commons/ (the
  # universal lint gate, release#320) plus the Kind's own subtree. A
  # consumer wanting capabilities ships a .release-sync.yaml.
  manifest_source="(none — manifest-less Kind; commons + Kind only)"
  capabilities=()
fi

for c in "${capabilities[@]}"; do
  [ -n "$c" ] || continue
  if ! git -C "$RELEASE_HOME" ls-tree -d --name-only "$ref" -- "templates/components/$c" \
       | grep -q .; then
    echo "release-sync: declared Capability '$c' has no templates/components/$c/ tree in $ref" >&2
    exit 1
  fi
done

echo "repo:         $repo_name"
echo "kind:         $kind"
echo "ref:          $ref ($ref_sha)"
echo "manifest:     $manifest_source"
echo "capabilities: ${capabilities[*]:-(none)}"
echo

# --- Plan ----------------------------------------------------------------

# Subtrees in low-to-high precedence: commons < each capability < kind
declare -a subtrees=("templates/commons")
for c in "${capabilities[@]}"; do
  [ -n "$c" ] || continue
  subtrees+=("templates/components/$c")
done
subtrees+=("templates/$kind")

should_skip_source() {
  case "$1" in
    */lefthook.fragment.yaml) return 0 ;;
    */manifest.yaml) return 0 ;;
    templates/components/_*) return 0 ;;
    *.DS_Store) return 0 ;;
  esac
  return 1
}

# Some paths can't be symlinks because the consuming tool doesn't
# dereference them. The known case: GitHub Actions workflows. GH reads
# .github/workflows/*.yml directly from the git tree and treats a
# symlink blob as the literal target path, which fails to parse and
# silently breaks every workflow in the directory. For these paths
# release-sync writes a real-file copy with a marker header comment
# so cleanup can later detect and remove stale managed copies.
needs_real_file() {
  case "$1" in
    .github/workflows/*) return 0 ;;
  esac
  return 1
}

# Release-internal metadata that lives ONLY inside .release/ — it is part
# of the tree (so --check sees it change) but is never mirrored out as a
# symlink/copy into the consumer's working tree.
is_release_internal() {
  case "$1" in
    "$SOURCE_MARKER") return 0 ;;
  esac
  return 1
}

MANAGED_MARKER='# Managed by release-sync — do not edit. Regenerate via release-sync.'

# Provenance marker: records which arthur-debert/release revision generated
# this .release/. Informational, not operational state — see ADR-0002. The
# drift detector (release-drift-check) reads the SHA to rebuild against the
# exact revision that produced this tree, separating real drift from mere
# staleness.
SOURCE_MARKER='.release-sync-source'

# Map every source path → (file_mode, destination relative to .release/).
# Last write wins (mirrors current release-sync precedence).
declare -A plan_mode=()
declare -A plan_source=()
declare -a plan_order=()

for st in "${subtrees[@]}"; do
  while IFS=$'\t' read -r meta rel; do
    [ -n "$rel" ] || continue
    should_skip_source "$rel" && continue
    file_mode=${meta%% *}
    dest=${rel#"$st"/}
    if [ -z "${plan_source[$dest]:-}" ]; then
      plan_order+=("$dest")
    fi
    plan_mode[$dest]=$file_mode
    plan_source[$dest]=$rel
  done < <(git -C "$RELEASE_HOME" ls-tree -r "$ref" -- "$st" 2>/dev/null || true)
done

# Compose lefthook.yml — this is a generated file, doesn't come from a single source path.
# Order = precedence: base header < commons (universal gate) < each
# capability < kind. The commons fragment applies to every consumer
# regardless of declared capabilities (release#320).
declare -a lefthook_frags=()
if git -C "$RELEASE_HOME" cat-file -e "$ref:templates/components/_lefthook-base.yaml" 2>/dev/null; then
  lefthook_frags+=("templates/components/_lefthook-base.yaml")
fi
if git -C "$RELEASE_HOME" cat-file -e "$ref:templates/commons/lefthook.fragment.yaml" 2>/dev/null; then
  lefthook_frags+=("templates/commons/lefthook.fragment.yaml")
fi
for c in "${capabilities[@]}"; do
  [ -n "$c" ] || continue
  fpath="templates/components/$c/lefthook.fragment.yaml"
  if git -C "$RELEASE_HOME" cat-file -e "$ref:$fpath" 2>/dev/null; then
    lefthook_frags+=("$fpath")
  fi
done
stack_frag="templates/$kind/lefthook.fragment.yaml"
if git -C "$RELEASE_HOME" cat-file -e "$ref:$stack_frag" 2>/dev/null; then
  lefthook_frags+=("$stack_frag")
fi

# --- Build the new .release/ tree in a tempdir -------------------------

# Create the tempdir as a sibling of .release/ so the final `mv` is a
# rename within the same filesystem (atomic). Otherwise mv across
# filesystems silently degrades to copy+delete.
tmp_release=$(mktemp -d "./.release-build.XXXXXX")
trap 'rm -rf "$tmp_release"' EXIT

for dest in "${plan_order[@]}"; do
  src=${plan_source[$dest]}
  # NB: use a dedicated name, NOT `mode` — that's the global run mode
  # (sync/check/dryrun). Reusing it here clobbered it to a file-mode
  # string, so --check/--dry-run silently fell through to apply.
  fmode=${plan_mode[$dest]}
  out="$tmp_release/$dest"
  mkdir -p "$(dirname "$out")"
  git -C "$RELEASE_HOME" show "$ref:$src" > "$out"
  if [ "$fmode" = "100755" ]; then chmod 755 "$out"; else chmod 644 "$out"; fi
done

# Generate lefthook.yml if we have fragments
if [ ${#lefthook_frags[@]} -gt 0 ]; then
  frag_tmp=$(mktemp -d)
  i=0
  declare -a frag_files=()
  for fp in "${lefthook_frags[@]}"; do
    out="$frag_tmp/$(printf '%02d' $i)-$(basename "$(dirname "$fp")").yaml"
    git -C "$RELEASE_HOME" show "$ref:$fp" > "$out"
    frag_files+=("$out")
    i=$((i + 1))
  done
  lefthook_out="$tmp_release/lefthook.yml"
  {
    printf '# Generated by release-sync from arthur-debert/release@%s. Do not edit.\n' "${ref_sha:0:12}"
    printf '# Regenerate by running release-sync.\n\n'
    # shellcheck disable=SC2016
    yq eval-all '. as $i ireduce({}; . *+ $i) | ... comments=""' "${frag_files[@]}"
  } > "$lefthook_out"
  rm -rf "$frag_tmp"
fi

# Provenance marker. The only dynamic line is the full source SHA, so the
# file round-trips: rebuilding from this SHA writes back the identical SHA,
# yielding no diff. The comment lines are static. (ADR-0002.)
{
  printf '# release-sync provenance — the arthur-debert/release commit that\n'
  printf '# generated this .release/. Informational, not operational state (ADR-0002).\n'
  printf '# Regenerated on every sync. release-drift-check reads the SHA below.\n'
  printf '%s\n' "$ref_sha"
} > "$tmp_release/$SOURCE_MARKER"

# --- Compute changes ----------------------------------------------------

# Collect all relative paths in the new tree
declare -a new_files=()
while IFS= read -r -d '' f; do
  rel=${f#"$tmp_release"/}
  new_files+=("$rel")
done < <(find "$tmp_release" -type f -print0)

# Collect all relative paths in the existing .release/ (if any)
declare -a old_files=()
if [ -d .release ]; then
  while IFS= read -r -d '' f; do
    rel=${f#.release/}
    old_files+=("$rel")
  done < <(find .release -type f -print0)
fi

# Changes: files added, modified, or removed in .release/
declare -a added=() modified=() removed=()
declare -A new_set=()
for f in "${new_files[@]}"; do new_set[$f]=1; done
declare -A old_set=()
for f in "${old_files[@]}"; do old_set[$f]=1; done

for f in "${new_files[@]}"; do
  if [ -z "${old_set[$f]:-}" ]; then
    added+=("$f")
  elif ! cmp -s "$tmp_release/$f" ".release/$f"; then
    modified+=("$f")
  fi
done
for f in "${old_files[@]}"; do
  if [ -z "${new_set[$f]:-}" ]; then
    removed+=("$f")
  fi
done

# Symlink/copy changes: each new file is either symlinked or copied.
declare -a symlinks_to_create=()
declare -a symlinks_to_remove=()
declare -a copies_to_write=()
declare -a conflicts=()
declare -a migrated=()

for f in "${new_files[@]}"; do
  if is_release_internal "$f"; then
    # Lives only inside .release/; not mirrored into the consumer tree.
    continue
  fi
  if needs_real_file "$f"; then
    # Always (re)write copies. They're regenerated from .release/ every
    # sync; never skip on conflict since the conflict IS expected on
    # initial migration AND on every content update.
    copies_to_write+=("$f")
    continue
  fi

  target=".release/$f"
  # Compute relative path from $f's location to .release/$f
  link_dir=$(dirname "$f")
  if [ "$link_dir" = "." ]; then
    link_target=".release/$f"
  else
    # Count depth of link_dir, each level needs ../
    depth=$(echo "$link_dir" | tr -cd '/' | wc -c)
    depth=$((depth + 1))
    prefix=""
    for ((i=0; i<depth; i++)); do prefix="../$prefix"; done
    link_target="${prefix}.release/$f"
  fi

  if [ -L "$f" ]; then
    current=$(readlink "$f")
    if [ "$current" != "$link_target" ]; then
      symlinks_to_create+=("$f -> $link_target")
    fi
  elif [ -e "$f" ]; then
    if [ "$migrate" = 1 ]; then
      # --migrate: treat conflict as something to remove + symlink
      migrated+=("$f")
      symlinks_to_create+=("$f -> $link_target")
    else
      conflicts+=("$f")
    fi
  else
    symlinks_to_create+=("$f -> $link_target")
  fi
done

# Find broken symlinks pointing into .release/ across the repo.
# Exclude .release/ itself — its contents are real files we just wrote.
while IFS= read -r -d '' link; do
  target=$(readlink "$link")
  case "$target" in
    *.release/*)
      if [ ! -e "$link" ]; then
        symlinks_to_remove+=("$link")
      fi
      ;;
  esac
done < <(find . -type l -not -path './.git/*' -not -path './.release/*' -print0 2>/dev/null)

# Build the set of expected copy destinations (this sync's needs_real_file paths).
declare -A copy_set=()
for f in "${copies_to_write[@]}"; do copy_set[$f]=1; done

# Walk paths where copies live to find stale managed copies — real
# files with the marker header that no longer have a corresponding
# .release/ source. Today only .github/workflows/ qualifies.
declare -a copies_to_remove=()
if [ -d .github/workflows ]; then
  while IFS= read -r -d '' candidate; do
    rel=${candidate#./}
    # Skip files already planned to be (re)written
    [ -n "${copy_set[$rel]:-}" ] && continue
    # Skip symlinks (those are someone else's concern)
    [ -L "$candidate" ] && continue
    # Only sweep files that carry the marker — leave hand-authored
    # consumer workflows alone.
    if head -1 "$candidate" 2>/dev/null | grep -qF "$MANAGED_MARKER"; then
      copies_to_remove+=("$rel")
    fi
  done < <(find .github/workflows -type f -print0 2>/dev/null)
fi

# --- Report -------------------------------------------------------------

echo "=== .release/ changes ==="
for f in "${added[@]}"; do echo "  +file     $f"; done
for f in "${modified[@]}"; do echo "  ~file     $f"; done
for f in "${removed[@]}"; do echo "  -file     $f"; done

echo
echo "=== symlink changes ==="
for s in "${symlinks_to_create[@]}"; do echo "  +link     $s"; done
for s in "${symlinks_to_remove[@]}"; do echo "  -link     $s (broken)"; done

if [ ${#copies_to_write[@]} -gt 0 ] || [ ${#copies_to_remove[@]} -gt 0 ]; then
  echo
  echo "=== copy changes (real-file managed paths) ==="
  for f in "${copies_to_write[@]}"; do echo "  =copy     $f"; done
  for f in "${copies_to_remove[@]}"; do echo "  -copy     $f (stale managed copy)"; done
fi

if [ ${#conflicts[@]} -gt 0 ]; then
  echo
  echo "=== conflicts (real file at managed location — symlink NOT created) ==="
  for f in "${conflicts[@]}"; do echo "  !file     $f"; done
  echo
  echo "Resolve by removing the real file, then re-running sync (or re-run with --migrate)."
fi

if [ ${#migrated[@]} -gt 0 ]; then
  echo
  echo "=== migrating (real file → symlink) ==="
  for f in "${migrated[@]}"; do echo "  >file     $f (will be deleted, then symlinked)"; done
fi

total_changes=$((${#added[@]} + ${#modified[@]} + ${#removed[@]} + ${#symlinks_to_create[@]} + ${#symlinks_to_remove[@]} + ${#migrated[@]} + ${#copies_to_write[@]} + ${#copies_to_remove[@]}))
echo
echo "summary: $total_changes changes, ${#conflicts[@]} conflicts"

if [ "$mode" = check ]; then
  # A conflict (a real file sitting where a managed symlink belongs) is
  # divergence too, even though it produces no planned change — sync
  # refuses to clobber it. --check must report it as non-clean, or a
  # consumer that replaced a managed symlink with a hand-edited real file
  # would pass the gate. (This is the headline drift case.)
  if [ "$total_changes" -eq 0 ] && [ "${#conflicts[@]}" -eq 0 ]; then
    exit 0
  else
    exit 1
  fi
fi

if [ "$mode" = dryrun ]; then
  exit 0
fi

# --- Apply --------------------------------------------------------------

# Replace .release/ atomically: build new tree alongside, swap.
if [ -d .release ]; then rm -rf .release; fi
mv "$tmp_release" .release
trap - EXIT

# If --migrate, delete real files at managed locations first
for f in "${migrated[@]}"; do
  rm -f "$f"
done

# Create / update symlinks
for s in "${symlinks_to_create[@]}"; do
  link=${s%% -> *}
  target=${s##* -> }
  mkdir -p "$(dirname "$link")"
  [ -L "$link" ] && rm "$link"
  ln -s "$target" "$link"
done

# Remove broken symlinks
for link in "${symlinks_to_remove[@]}"; do
  rm "$link"
done

# Write managed copies (real files for paths GH can't dereference).
# If the destination is currently a symlink (e.g. leftover from a
# previous sync that wrongly tried to symlink it), remove the link
# first so we write the real file in its place.
for f in "${copies_to_write[@]}"; do
  mkdir -p "$(dirname "$f")"
  [ -L "$f" ] && rm "$f"
  src=".release/$f"
  # Detect file kind from the source extension for the comment syntax.
  case "$f" in
    *.yml|*.yaml)
      {
        printf '%s\n' "$MANAGED_MARKER"
        cat "$src"
      } > "$f"
      ;;
    *)
      # Fallback: just copy as-is. Other file types (not currently used
      # under .github/workflows/) can grow their own header style later.
      cp "$src" "$f"
      ;;
  esac
  # Preserve executable bit from the source.
  if [ -x "$src" ]; then chmod +x "$f"; fi
done

# Remove stale managed copies — files that carry the marker but no
# longer have a .release/ source.
for f in "${copies_to_remove[@]}"; do
  rm "$f"
done

echo
echo "done."

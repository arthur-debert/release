#!/usr/bin/env python3
# release-sync — materialize managed files into a consumer repo (ADR-0001).
#
# Thin shim (shell→Python Phase 2): put the
# stdlib-only release_core package on sys.path and dispatch. release-sync is a
# release-only tool (a real file in bin/, NOT synced to consumers), so realpath
# lands in bin/ and the package sits at ../templates/commons/lib/release_core
# (the contract's variant (b)). Behavior matches the old bash byte-for-byte.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import release_sync  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(release_sync.main(sys.argv[1:]))

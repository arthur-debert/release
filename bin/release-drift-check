#!/usr/bin/env python3
# release-drift-check — consumer-side drift gate (ADR-0002, release#301).
#
# Thin shim (shell→Python Phase 2, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. release-drift-check
# is a release-only tool (a real file in bin/, NOT synced to consumers), so
# realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core (the contract's variant (b)). It runs
# wherever release-sync runs — agent-side in the release clone, or a consumer CI
# job that checks out arthur-debert/release and points $RELEASE_HOME / PATH at
# it — so release_core is always reachable by the same resolution as release-sync.
# Behavior matches the old bash byte-for-byte.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import release_drift_check  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(release_drift_check.main(sys.argv[1:]))

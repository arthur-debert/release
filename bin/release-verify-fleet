#!/usr/bin/env python3
# release-verify-fleet — hermetic pre-flight lint sweep across the fleet.
#
# Thin shim (shell→Python Phase 2, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. release-verify-fleet
# is a release-only tool (a real file in bin/, NOT synced to consumers), so
# realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core (the contract's variant (b)). Stdout,
# stderr, and exit codes match the old bash byte-for-byte. We export the script's
# own bin/ dir so the verb resolves RELEASE_HOME at bin/../ exactly as the bash
# computed it from $BASH_SOURCE.
import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
os.environ.setdefault("VERIFY_FLEET_SCRIPT_DIR", _HERE)
sys.path.insert(
    0,
    os.path.join(_HERE, "..", "templates", "commons", "lib", "release_core"),
)

from release_core.verbs import release_verify_fleet  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(release_verify_fleet.main(sys.argv[1:]))

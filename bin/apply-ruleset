#!/usr/bin/env bash
# Apply the canonical main-branch ruleset to a GitHub repo.
#
# Usage:
#   apply-ruleset [--dry-run] [--checks check1,check2,...]
#
# Auto-detects:
#   - repo from current git/gh context (gh repo view)
#   - required checks: actual job names from the most recent default-branch
#     run of each PR-trigger workflow (excluding copilot-review.yml — it
#     isn't a gate). This catches matrix expansion (e.g. "Build
#     (aarch64-apple-darwin)") and `name:` overrides that yq can't see.
#     Falls back to yq job IDs if no runs exist yet.
# Override checks with --checks (comma-separated). Use --dry-run to print the
# payload without sending it.

set -euo pipefail

dry_run=0
checks_override=""

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=1; shift ;;
    --checks)  checks_override=$2; shift 2 ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 64 ;;
  esac
done

repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)

if [ -n "$checks_override" ]; then
  checks_str=$(echo "$checks_override" | tr ',' '\n')
else
  workflows_dir=$(git rev-parse --show-toplevel)/.github/workflows
  [ -d "$workflows_dir" ] || { echo "no .github/workflows dir; pass --checks <names>" >&2; exit 1; }

  # Step 1: collect workflow file paths triggered on pull_request, excluding copilot-review.
  pr_workflow_paths=()
  for f in "$workflows_dir"/*.yml "$workflows_dir"/*.yaml; do
    [ -f "$f" ] || continue
    case "$(basename "$f")" in
      copilot-review.yml|copilot-review.yaml) continue ;;
    esac
    triggers=$(yq -o json . "$f" 2>/dev/null | jq -r '
      .on as $on |
      if   ($on | type) == "string" then [$on]
      elif ($on | type) == "array"  then $on
      elif ($on | type) == "object" then ($on | keys)
      else [] end | .[]
    ' 2>/dev/null)
    if echo "$triggers" | grep -qx pull_request; then
      pr_workflow_paths+=(".github/workflows/$(basename "$f")")
    fi
  done

  # Step 2: actual check-run names from the latest default-branch run of each.
  default_branch=$(gh api "repos/$repo" --jq .default_branch)
  checks_str=$(
    for path in "${pr_workflow_paths[@]}"; do
      wid=$(gh api "repos/$repo/actions/workflows" --jq ".workflows[] | select(.path == \"$path\") | .id" 2>/dev/null)
      [ -n "$wid" ] && [ "$wid" != "null" ] || continue
      run_id=$(gh api "repos/$repo/actions/workflows/$wid/runs?branch=$default_branch&per_page=1" --jq '.workflow_runs[0].id' 2>/dev/null)
      [ -n "$run_id" ] && [ "$run_id" != "null" ] || continue
      gh api --paginate "repos/$repo/actions/runs/$run_id/jobs" --jq '.jobs[].name' 2>/dev/null
    done | sort -u
  )

  # Step 3: fallback to yq job IDs if no runs yet (brand-new repo).
  if [ -z "$checks_str" ]; then
    checks_str=$(
      for path in "${pr_workflow_paths[@]}"; do
        yq -r '.jobs | keys | .[]' "$(git rev-parse --show-toplevel)/$path" 2>/dev/null
      done | sort -u
    )
  fi
fi

if [ -z "$checks_str" ]; then
  echo "no required checks could be determined; pass --checks <names>" >&2
  exit 1
fi

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
tmpl="$script_dir/../rulesets/main-protection.json.tmpl"
[ -f "$tmpl" ] || { echo "template not found: $tmpl" >&2; exit 1; }

checks_json=$(printf '%s\n' "$checks_str" | jq -R 'select(. != "") | {context: .}' | jq -s .)

body=$(jq --argjson c "$checks_json" '
  .rules |= map(
    if .type == "required_status_checks"
    then .parameters.required_status_checks = $c
    else .
    end
  )
' "$tmpl")

name=$(jq -r '.name' <<<"$body")
existing_id=$(gh api "repos/$repo/rulesets" --jq ".[] | select(.name == \"$name\") | .id" | head -1 || true)

printf 'repo:    %s\n' "$repo"
printf 'ruleset: %s (existing id: %s)\n' "$name" "${existing_id:-none}"
printf 'checks:  %s\n' "$(echo "$checks_str" | paste -sd, -)"

if [ "$dry_run" = 1 ]; then
  echo
  echo "--- payload (dry-run, not sent) ---"
  jq . <<<"$body"
  exit 0
fi

if [ -n "$existing_id" ]; then
  jq . <<<"$body" | gh api -X PUT "repos/$repo/rulesets/$existing_id" --input - --silent
  echo "updated"
else
  jq . <<<"$body" | gh api -X POST "repos/$repo/rulesets" --input - --silent
  echo "created"
fi

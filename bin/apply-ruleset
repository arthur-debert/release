#!/usr/bin/env python3
# apply-ruleset — apply the canonical main-branch ruleset to a GitHub repo.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. apply-ruleset is a
# release-only tool (a real file in bin/, NOT synced to consumers), so realpath
# lands in bin/ and the package sits at ../templates/commons/lib/release_core
# (the contract's variant (b)). The stdout lines, dry-run payload, and exit
# codes match the old bash byte-for-byte.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import apply_ruleset  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(apply_ruleset.main(sys.argv[1:]))

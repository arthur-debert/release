#!/usr/bin/env python3
# enable-dependabot-security — enable Dependabot security updates on onboarded repos.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch.
# enable-dependabot-security is a release-only tool (a real file in bin/, NOT
# synced to consumers), so realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core (the contract's variant (b)). The
# discovery header, per-repo ok/FAIL lines, summary, and exit codes match the
# old bash byte-for-byte.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import enable_dependabot_security  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(enable_dependabot_security.main(sys.argv[1:]))

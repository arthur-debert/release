#!/usr/bin/env python3
# IMPORTANT: this file MUST stay a real file, never a symlink. Consumers
# and electron-app.yml fetch it via raw.githubusercontent.com, which
# serves a symlink blob as its target *string* (not the script) — that
# broke five consumers' CI when this was briefly symlinked (release#317).
# A CI guard in .github/workflows/ci.yml enforces this.
#
# Self-contained, stdlib-only Python (shell→Python port, see
# docs/proposals/shell-to-python.md). Fetched standalone via
# raw.githubusercontent.com and run with NO release_core present, so it
# imports nothing beyond the stdlib and is NOT a release_core shim — this
# decouples the port from the pull-model distribution. Network I/O still
# shells out to `curl` (preserving the auth-header semantics and the BATS
# curl-mock contract); extraction shells out to `tar`/`unzip`. `deps.json`
# is parsed with the stdlib `json` module, so `jq` is no longer required at
# all: the manifest-iteration `for-each` is a dotted path ending in `[]`
# (the only shape the fleet uses), evaluated in-process. sha256 verification
# uses stdlib `hashlib`.
"""fetch-deps — download dependencies declared in deps.json."""

from __future__ import annotations

import hashlib
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile

VERSION = "0.2.0"
PROG = "fetch-deps"


class Die(SystemExit):
    """Hard exit (config error / integrity failure) — never soft-swallowed."""


def die(msg: str) -> Die:
    print(f"{PROG}: {msg}", file=sys.stderr)
    return Die(1)


def info(msg: str) -> None:
    print(f"  {msg}")


def ok(msg: str) -> None:
    print(f"  ✓ {msg}")


def skip(msg: str) -> None:
    print(f"  ⊘ {msg}")


def fail_dep(msg: str) -> bool:
    """Soft failure — print and report False so the caller can decide."""
    print(f"{PROG}: {msg}", file=sys.stderr)
    return False


# ─── Platform detection ───────────────────────────────────


def detect_target() -> str:
    sysname = platform.system()
    if sysname == "Linux":
        os_part = "unknown-linux-gnu"
    elif sysname == "Darwin":
        os_part = "apple-darwin"
    elif sysname == "Windows" or sysname.startswith(("MINGW", "MSYS", "CYGWIN")):
        os_part = "pc-windows-msvc"
    else:
        raise die(f"unsupported OS: {sysname}")

    mach = platform.machine()
    if mach in ("x86_64", "AMD64"):
        arch = "x86_64"
    elif mach in ("aarch64", "arm64", "ARM64"):
        arch = "aarch64"
    else:
        raise die(f"unsupported arch: {mach}")
    return f"{arch}-{os_part}"


def target_os(t: str) -> str:
    if "linux" in t:
        return "linux"
    if "darwin" in t:
        return "macos"
    if "windows" in t:
        return "windows"
    return "unknown"


def target_arch(t: str) -> str:
    if t.startswith("x86_64"):
        return "x86_64"
    if t.startswith("aarch64") or t.startswith("arm64"):
        return "aarch64"
    return "unknown"


def target_node_platform(t: str) -> str:
    if "linux" in t:
        return "linux"
    if "darwin" in t:
        return "darwin"
    if "windows" in t:
        return "win32"
    return "unknown"


def target_node_arch(t: str) -> str:
    if t.startswith("x86_64"):
        return "x64"
    if t.startswith("aarch64") or t.startswith("arm64"):
        return "arm64"
    return "unknown"


def archive_ext(t: str) -> str:
    return ".zip" if "windows" in t else ".tar.gz"


def is_archive(name: str) -> bool:
    return name.endswith((".tar.gz", ".tgz", ".zip"))


# ─── Template expansion ───────────────────────────────────

# Cache target-derived values for the whole run (target is fixed).
_CACHE: dict[str, str] = {}


def cache_target_vars(target: str) -> None:
    _CACHE["os"] = target_os(target)
    _CACHE["arch"] = target_arch(target)
    _CACHE["node_platform"] = target_node_platform(target)
    _CACHE["node_arch"] = target_node_arch(target)
    _CACHE["ext"] = archive_ext(target)


def expand_template(tpl: str, target: str) -> str:
    result = tpl
    result = result.replace("{{target}}", target)
    result = result.replace("{{os}}", _CACHE["os"])
    result = result.replace("{{arch}}", _CACHE["arch"])
    result = result.replace("{{node_platform}}", _CACHE["node_platform"])
    result = result.replace("{{node_arch}}", _CACHE["node_arch"])
    result = result.replace("{{ext}}", _CACHE["ext"])
    return result


def _jq_tostring(v: object) -> str:
    """Mimic jq's `// "" | tostring` for a manifest-item field."""
    if v is None:
        return ""
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, str):
        return v
    if isinstance(v, (int, float)):
        return str(v)
    return json.dumps(v, separators=(",", ":"))


_ITEM_RE = re.compile(r"\{\{\.([a-zA-Z_][a-zA-Z0-9_]*)\}\}")


def expand_item_template(tpl: str, item: dict, target: str) -> str:
    interim = _ITEM_RE.sub(lambda m: _jq_tostring(item.get(m.group(1))), tpl)
    return expand_template(interim, target)


# ─── Stamp management ─────────────────────────────────────

STAMP_DIR = ".deps"


def stamp_path(key: str) -> str:
    return os.path.join(STAMP_DIR, f"{key}.stamp")


def stamp_matches(key: str, expected: str) -> bool:
    p = stamp_path(key)
    if not os.path.isfile(p):
        return False
    try:
        with open(p, encoding="utf-8") as fh:
            recorded = fh.readline().rstrip("\n")
    except OSError:
        return False
    return recorded == expected


def stamp_write(key: str, content: str) -> None:
    p = stamp_path(key)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as fh:
        fh.write(content)


# ─── Download ──────────────────────────────────────────────


def _auth_token() -> str:
    return os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN") or ""


def _curl(args: list[str], capture: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["curl", *args],
        capture_output=capture,
        text=True,
    )


def download_url(url: str, dest: str) -> bool:
    """Plain HTTPS download. Auth header only for github.com hosts so
    arbitrary URLs (HuggingFace, CDNs) don't leak tokens."""
    token = _auth_token()
    rest = url.split("://", 1)[-1]
    host = rest.split("/", 1)[0]
    host = host.split("@")[-1].split(":")[0]

    github_hosts = {"github.com", "raw.githubusercontent.com", "api.github.com"}
    if token and host in github_hosts:
        cp = _curl(["-fsSL", "-H", f"Authorization: Bearer {token}", "-o", dest, url])
    else:
        cp = _curl(["-fsSL", "-o", dest, url])
    if cp.returncode != 0:
        print(f"{PROG}: download failed: {url}", file=sys.stderr)
        return False
    return True


def download_release_asset(repo: str, version: str, asset: str, dest: str) -> bool:
    """Download a GitHub release asset. For private repos the browser-style
    URL strips Authorization on the 302, so when a token is present we resolve
    the asset URL via the API and download with Accept: octet-stream."""
    token = _auth_token()
    if token:
        api_url = f"https://api.github.com/repos/{repo}/releases/tags/{version}"
        cp = _curl(["-fsSL", "-H", f"Authorization: Bearer {token}", api_url], capture=True)
        if cp.returncode != 0:
            print(
                f"{PROG}: failed to look up release {version} for {repo}",
                file=sys.stderr,
            )
            return False
        asset_url = ""
        try:
            payload = json.loads(cp.stdout)
            for a in payload.get("assets", []):
                if a.get("name") == asset:
                    asset_url = a.get("url") or ""
                    break
        except ValueError:
            asset_url = ""
        if not asset_url or asset_url == "null":
            print(
                f"{PROG}: {repo}@{version}: asset {asset} not found in release",
                file=sys.stderr,
            )
            return False
        cp = _curl(
            [
                "-fsSL",
                "-H",
                f"Authorization: Bearer {token}",
                "-H",
                "Accept: application/octet-stream",
                "-o",
                dest,
                asset_url,
            ]
        )
        if cp.returncode != 0:
            print(
                f"{PROG}: download failed: {asset} from {repo}@{version}",
                file=sys.stderr,
            )
            return False
        return True
    else:
        url = f"https://github.com/{repo}/releases/download/{version}/{asset}"
        cp = _curl(["-fsSL", "-o", dest, url])
        if cp.returncode != 0:
            print(
                f"{PROG}: download failed: {url} (private repo? set GH_TOKEN)",
                file=sys.stderr,
            )
            return False
        return True


def download_raw_github(repo: str, version: str, path: str, dest: str) -> bool:
    return download_url(f"https://raw.githubusercontent.com/{repo}/{version}/{path}", dest)


def sha256_of(path: str) -> str | None:
    try:
        h = hashlib.sha256()
        with open(path, "rb") as fh:
            for chunk in iter(lambda: fh.read(65536), b""):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return None


# ─── Extraction ────────────────────────────────────────────


def extract_archive(archive: str, dest: str) -> bool:
    os.makedirs(dest, exist_ok=True)
    try:
        if archive.endswith((".tar.gz", ".tgz")):
            return subprocess.run(["tar", "-xzf", archive, "-C", dest]).returncode == 0
        if archive.endswith(".zip"):
            return subprocess.run(["unzip", "-qo", archive, "-d", dest]).returncode == 0
    except FileNotFoundError:
        # Missing tar/unzip — fail the dep cleanly instead of a traceback
        # (the bash `tar`/`unzip` would exit 127 and fail the dep too).
        cmd = "tar" if archive.endswith((".tar.gz", ".tgz")) else "unzip"
        print(f"{PROG}: required command not found: {cmd}", file=sys.stderr)
        return False
    print(f"{PROG}: unsupported archive format: {archive}", file=sys.stderr)
    return False


def extract_root(directory: str) -> str:
    """If the archive unpacked to a single top-level dir, return it (the GH
    convention); otherwise the directory itself. Glob semantics ignore
    dotfiles, like bash `for entry in "$dir"/*`."""
    entries = [e for e in sorted(os.listdir(directory)) if not e.startswith(".")]
    if len(entries) == 1:
        single = os.path.join(directory, entries[0])
        if os.path.isdir(single):
            return single
    return directory


def find_binary(root: str, name: str) -> str | None:
    for dirpath, _dirs, files in os.walk(root):
        _dirs.sort()  # deterministic descent order across platforms
        for f in sorted(files):
            if f == name:
                p = os.path.join(dirpath, f)
                if os.path.isfile(p):
                    return p
    return None


def _find_by_basename(root: str, base: str) -> str | None:
    for dirpath, _dirs, files in os.walk(root):
        _dirs.sort()  # deterministic descent order across platforms
        for f in sorted(files):
            if f == base:
                return os.path.join(dirpath, f)
        for d in _dirs:
            if d == base:
                return os.path.join(dirpath, d)
    return None


def apply_extract_map(root: str, extract_map: dict) -> bool:
    """Apply a {src: dst} extract map against an unpacked archive root.
    Returns False if any entry could not be applied (missing source or a
    failed mkdir/copy) so the caller fails the dep loudly."""
    failed = False
    for src, dst in extract_map.items():
        if not src or not dst:
            continue
        candidate = os.path.join(root, src)
        if os.path.exists(candidate):
            found = candidate
        else:
            found = _find_by_basename(root, os.path.basename(src))

        if not found:
            fail_dep(f"extract: '{src}' not found in archive")
            failed = True
            continue

        try:
            os.makedirs(dst, exist_ok=True)
        except OSError:
            fail_dep(f"extract: cannot create dest dir '{dst}'")
            failed = True
            continue

        try:
            if os.path.isdir(found):
                # cp -r "$found"/. "$dst/" — copy contents into dst.
                shutil.copytree(found, dst, dirs_exist_ok=True)
            else:
                shutil.copy(found, dst)
        except (OSError, shutil.Error):
            fail_dep(f"extract: failed to copy '{src}' → '{dst}'")
            failed = True
            continue
        ok(f"{src} → {dst}")
    return not failed


# ─── Process a single dep ─────────────────────────────────

_DEP_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def process_dep(dep: str, item_cfg: dict, if_missing: bool, target: str, work_dir: str) -> bool:
    # Invalid names / missing required fields are static config bugs, not
    # transient runtime errors — die hard so --soft / "optional" don't
    # silently swallow them.
    if not _DEP_NAME_RE.match(dep):
        raise die(f"invalid dependency name: {dep}")

    if "from-manifest" in item_cfg:
        return fetch_iter(dep, item_cfg, if_missing, target, work_dir)
    if "url" in item_cfg:
        return fetch_url(dep, item_cfg, if_missing, target, work_dir)
    return fetch_github(dep, item_cfg, if_missing, target, work_dir)


def fetch_github(dep: str, cfg: dict, if_missing: bool, target: str, work_dir: str) -> bool:
    repo = str(cfg.get("repo") or "")
    version = str(cfg.get("version") or "")
    asset_tpl = str(cfg.get("asset") or "")
    binary = str(cfg.get("binary") or "")
    dest_tpl = str(cfg.get("dest") if cfg.get("dest") not in (None, "") else ".")
    has_extract = "extract" in cfg

    if not repo:
        raise die(f"{dep}: missing 'repo'")
    if not version:
        raise die(f"{dep}: missing 'version'")
    if not asset_tpl:
        raise die(f"{dep}: missing 'asset'")

    asset = expand_template(asset_tpl, target)
    dest = expand_template(dest_tpl, target)

    if if_missing and stamp_matches(dep, f"{version} {target}"):
        skip(f"{dep} {version} — up to date")
        return True

    info(f"{dep} {version} → {dest}")

    dep_dir = os.path.join(work_dir, dep)
    os.makedirs(dep_dir, exist_ok=True)

    if not download_release_asset(repo, version, asset, os.path.join(dep_dir, asset)):
        return False

    if not extract_archive(os.path.join(dep_dir, asset), os.path.join(dep_dir, "out")):
        return False
    root = extract_root(os.path.join(dep_dir, "out"))

    if binary:
        bin_name = binary
        if "windows" in target:
            bin_name = f"{binary}.exe"
        found = find_binary(root, bin_name)
        if not found:
            return fail_dep(f"{dep}: binary '{bin_name}' not found in archive")
        os.makedirs(dest, exist_ok=True)
        shutil.copyfile(found, os.path.join(dest, bin_name))
        os.chmod(os.path.join(dest, bin_name), 0o755)
        ok(f"{bin_name} → {dest}/")
    elif has_extract:
        extract_map = dict(cfg.get("extract") or {})
        if not apply_extract_map(root, extract_map):
            return False
    else:
        os.makedirs(dest, exist_ok=True)
        shutil.copytree(root, dest, dirs_exist_ok=True)
        ok(f"extracted → {dest}/")

    stamp_write(dep, f"{version} {target}")
    return True


def fetch_url(dep: str, cfg: dict, if_missing: bool, target: str, work_dir: str) -> bool:
    url_tpl = str(cfg.get("url") or "")
    filename_tpl = str(cfg.get("filename") or "")
    dest_tpl = str(cfg.get("dest") if cfg.get("dest") not in (None, "") else ".")
    sha256 = str(cfg.get("sha256") or "")

    if not url_tpl:
        raise die(f"{dep}: missing 'url'")

    url = expand_template(url_tpl, target)
    dest = expand_template(dest_tpl, target)
    if filename_tpl:
        filename = expand_template(filename_tpl, target)
    else:
        path = url.split("?", 1)[0]
        filename = os.path.basename(path)

    stamp_id = f"sha256:{sha256}" if sha256 else f"url:{url}"

    if if_missing and stamp_matches(dep, stamp_id):
        skip(f"{dep} — up to date")
        return True

    info(f"{dep} → {dest}/{filename}")

    dep_dir = os.path.join(work_dir, dep)
    os.makedirs(dep_dir, exist_ok=True)

    if not download_url(url, os.path.join(dep_dir, filename)):
        return False

    if sha256:
        actual = sha256_of(os.path.join(dep_dir, filename))
        if actual is None:
            raise die(f"{dep}: cannot compute sha256")
        if actual != sha256:
            # Integrity failure: hard fail even under --soft.
            raise die(f"{dep}: sha256 mismatch (expected {sha256}, got {actual})")

    os.makedirs(dest, exist_ok=True)
    shutil.copy(os.path.join(dep_dir, filename), os.path.join(dest, filename))
    ok(f"{filename} → {dest}/")

    stamp_write(dep, stamp_id)
    return True


# ─── for-each evaluation (jq-free) ─────────────────────────

# `for-each` selects the array to iterate. In practice — and across the entire
# fleet — it is always a dotted path ending in `[]` (`.grammars[]`,
# `.items[]`, `.a.b[]`). We evaluate that subset directly so no jq engine is
# needed; expressions outside it raise ForEachError with a clear message.
_FOR_EACH_RE = re.compile(r"^\.((?:[A-Za-z_][A-Za-z0-9_]*)(?:\.[A-Za-z_][A-Za-z0-9_]*)*)?\[\]$")


class ForEachError(ValueError):
    """A for-each expression outside the supported subset, or not selecting
    an array."""


def eval_for_each(expr: str, data: object) -> list:
    """Return the list selected by a `.a.b[]`-style for-each expression.

    A path that doesn't resolve (missing key) yields an empty list, matching
    "nothing to iterate". A resolved-but-non-array target, or syntax beyond
    the supported subset, raises ForEachError.
    """
    m = _FOR_EACH_RE.match(expr.strip())
    if not m:
        raise ForEachError(
            f"unsupported for-each expression '{expr}' "
            "(supported: a dotted path ending in [], e.g. .grammars[])"
        )
    path = m.group(1)
    cur = data
    if path:
        for key in path.split("."):
            if isinstance(cur, dict) and key in cur:
                cur = cur[key]
            else:
                return []
    if not isinstance(cur, list):
        raise ForEachError(f"for-each '{expr}' did not select an array")
    return cur


def fetch_iter(dep: str, cfg: dict, if_missing: bool, target: str, work_dir: str) -> bool:
    manifest_tpl = str(cfg.get("from-manifest") or "")
    for_each = str(cfg.get("for-each") or "")
    repo_tpl = str(cfg.get("repo") or "")
    version_tpl = str(cfg.get("version") or "")
    asset_tpl = str(cfg.get("asset") or "")
    dest_tpl = str(cfg.get("dest") if cfg.get("dest") not in (None, "") else ".")
    binary_as_tpl = str(cfg.get("binary-as") or "")
    has_extract = "extract" in cfg
    has_raw = "raw-files" in cfg

    # Validate in author-friendly order: from-manifest → for-each → the
    # GH-release fields.
    if not manifest_tpl:
        raise die(f"{dep}: missing 'from-manifest'")
    if not for_each:
        raise die(f"{dep}: missing 'for-each'")
    if not repo_tpl:
        raise die(f"{dep}: missing 'repo'")
    if not version_tpl:
        raise die(f"{dep}: missing 'version'")
    if not asset_tpl:
        raise die(f"{dep}: missing 'asset'")

    extract_map = dict(cfg.get("extract") or {}) if has_extract else {}
    raw_pairs = dict(cfg.get("raw-files") or {}) if has_raw else {}

    manifest = expand_template(manifest_tpl, target)
    if not os.path.isfile(manifest):
        return fail_dep(f"{dep}: manifest not found: {manifest}")
    try:
        with open(manifest, encoding="utf-8") as fh:
            manifest_data = json.load(fh)
    except (OSError, ValueError):
        return fail_dep(f"{dep}: invalid JSON in manifest: {manifest}")

    # Evaluate `for-each` in-process (no jq). It is always a dotted path
    # ending in `[]` across the whole fleet (e.g. `.grammars[]`); anything
    # outside that subset raises a clear error rather than silently misbehaving.
    try:
        items = eval_for_each(for_each, manifest_data)
    except ForEachError as e:
        return fail_dep(f"{dep}: {e}")

    info(f"{dep}: iterating {for_each} over {manifest}")

    item_failed = 0
    for item in items:
        if not isinstance(item, dict):
            item = {}
        if not fetch_iter_item(
            dep,
            item,
            if_missing,
            target,
            work_dir,
            repo_tpl,
            version_tpl,
            asset_tpl,
            dest_tpl,
            binary_as_tpl,
            has_extract,
            extract_map,
            has_raw,
            raw_pairs,
        ):
            item_failed += 1

    return item_failed == 0


def fetch_iter_item(
    dep: str,
    item: dict,
    if_missing: bool,
    target: str,
    work_dir: str,
    repo_tpl: str,
    version_tpl: str,
    asset_tpl: str,
    dest_tpl: str,
    binary_as_tpl: str,
    has_extract: bool,
    extract_map: dict,
    has_raw: bool,
    raw_pairs: dict,
) -> bool:
    item_name = ""
    if isinstance(item, dict):
        item_name = _jq_tostring(item.get("name")) if item.get("name") is not None else ""
    if not item_name:
        return fail_dep(f"{dep}: iteration item missing 'name' field")

    repo = expand_item_template(repo_tpl, item, target)
    version = expand_item_template(version_tpl, item, target)
    asset = expand_item_template(asset_tpl, item, target)
    dest = expand_item_template(dest_tpl, item, target)
    binary_as = expand_item_template(binary_as_tpl, item, target) if binary_as_tpl else ""

    stamp_key = f"{dep}/{item_name}"
    if if_missing and stamp_matches(stamp_key, f"{version} {target}"):
        skip(f"{dep}/{item_name} {version} — up to date")
        return True

    info(f"{dep}/{item_name} {version} → {dest}")

    item_dir = os.path.join(work_dir, dep, item_name)
    os.makedirs(item_dir, exist_ok=True)

    if not download_release_asset(repo, version, asset, os.path.join(item_dir, asset)):
        return False

    os.makedirs(dest, exist_ok=True)
    if binary_as:
        # The asset itself is the file we want — copy with the configured
        # name. No extraction.
        shutil.copy(os.path.join(item_dir, asset), os.path.join(dest, binary_as))
        ok(f"{binary_as} → {dest}/")
    elif is_archive(asset):
        if not extract_archive(os.path.join(item_dir, asset), os.path.join(item_dir, "out")):
            return False
        root = extract_root(os.path.join(item_dir, "out"))
        if has_extract:
            expanded = {
                expand_item_template(k, item, target): expand_item_template(v, item, target)
                for k, v in extract_map.items()
                if k
            }
            if not apply_extract_map(root, expanded):
                return fail_dep(f"{dep}/{item_name}: extract failed")
        else:
            shutil.copytree(root, dest, dirs_exist_ok=True)
            ok(f"extracted → {dest}/")
    else:
        # Non-archive asset, no binary-as configured: copy as-is.
        shutil.copy(os.path.join(item_dir, asset), os.path.join(dest, os.path.basename(asset)))
        ok(f"{asset} → {dest}/")

    # raw-files: additional files from raw.githubusercontent.com.
    if has_raw:
        for rsrc, rdst in raw_pairs.items():
            if not rsrc:
                continue
            esrc = expand_item_template(rsrc, item, target)
            edst = expand_item_template(rdst, item, target)
            if not download_raw_github(repo, version, esrc, os.path.join(dest, edst)):
                return fail_dep(f"{dep}/{item_name}: raw-file '{esrc}' failed")
            ok(f"raw {esrc} → {dest}/{edst}")

    stamp_write(stamp_key, f"{version} {target}")
    return True


def is_soft_dep(cfg: dict, soft_flag: bool) -> bool:
    """Soft deps log warnings and don't count toward the failure total."""
    if soft_flag:
        return True
    return bool(cfg.get("optional", False) is True or cfg.get("optional") == "true")


# ─── CLI ───────────────────────────────────────────────────

USAGE = """\
Usage: fetch-deps [options] [dep ...]

Download dependencies defined in deps.json. Three shapes are supported:
  1. GitHub release asset (default)
  2. Plain HTTPS URL (any host)
  3. Manifest-driven iteration (loop over a JSON manifest on disk)

Options:
  --if-missing     Skip deps whose stamp matches the current identity
  --target TRIPLE  Override platform detection (e.g. x86_64-apple-darwin)
  --config FILE    Config file path (default: deps.json)
  --soft           Treat every dep as optional: log warnings and exit 0
                   on download/extraction failure. Useful for npm/Electron
                   postinstall hooks where hard-failure would break
                   `npm install` outside CI. sha256 mismatches and
                   config errors still hard-fail.
  --help           Show this help
  --version        Show version

With no dep names, fetches all deps in the config file.

deps.json — GitHub release shape:
  {
    "dep-name": {
      "repo":     "owner/repo",           (required)
      "version":  "v1.2.3",               (required)
      "asset":    "name-{{target}}{{ext}}", (required, templated)
      "binary":   "binary-name",          (binary mode: find + install)
      "dest":     "resources",            (install dir, default ".", templated)
      "optional": true,                   (soft-fail this dep)
      "extract":  { "file.wasm": "resources", "queries": "resources/queries" }
    }
  }

deps.json — plain HTTPS URL shape:
  {
    "dep-name": {
      "url":      "https://host/path/to/file",   (required)
      "filename": "saved-name.bin",              (default: basename of url)
      "dest":     "static/models",               (default ".", templated)
      "sha256":   "abc123…",                     (optional, integrity check)
      "optional": true
    }
  }

deps.json — manifest iteration shape:
  {
    "dep-name": {
      "from-manifest": "resources/manifest.json",  (path on disk, templated)
      "for-each":      ".items[]",                  (array path, ends in [])
      "repo":          "{{.repo}}",                 (per-item templates)
      "version":       "{{.version}}",
      "asset":         "{{.asset_name}}",
      "dest":          "out/{{.name}}",
      "binary-as":     "parser.wasm",   (asset is a single file → save as)
      "raw-files":     { "{{.queries_path}}": "highlights.scm" }
    }
  }
  Each iteration item must have a "name" field (used for stamps).

Template variables (global, expand in any string):
  {{target}}         Rust target triple    (x86_64-unknown-linux-gnu)
  {{os}}             OS name (Rust style)  (linux, macos, windows)
  {{arch}}           Architecture (Rust)   (x86_64, aarch64)
  {{node_platform}}  OS name (Node style)  (linux, darwin, win32)
  {{node_arch}}      Architecture (Node)   (x64, arm64)
  {{ext}}            Archive extension     (.tar.gz on Unix, .zip on Windows)

Per-item placeholders (iteration mode only): {{.field}} reads the named
field from the current manifest item.
"""


def main(argv: list[str]) -> int:
    if_missing = False
    soft = False
    target = ""
    config = "deps.json"
    deps: list[str] = []

    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--if-missing":
            if_missing = True
            i += 1
        elif a == "--soft":
            soft = True
            i += 1
        elif a == "--target":
            if i + 1 >= len(argv):
                raise die("--target requires a value")
            target = argv[i + 1]
            i += 2
        elif a == "--config":
            if i + 1 >= len(argv):
                raise die("--config requires a value")
            config = argv[i + 1]
            i += 2
        elif a == "--help":
            print(USAGE, end="")
            return 0
        elif a == "--version":
            print(f"{PROG} {VERSION}")
            return 0
        elif a.startswith("-"):
            raise die(f"unknown option: {a}")
        else:
            deps.append(a)
            i += 1

    if shutil.which("curl") is None:
        raise die("curl is required but not found")

    if not target:
        target = detect_target()
    cache_target_vars(target)

    if not os.path.isfile(config):
        raise die(f"config not found: {config}")
    try:
        with open(config, encoding="utf-8") as fh:
            cfg_data = json.load(fh)
    except (OSError, ValueError):
        raise die(f"invalid JSON: {config}") from None
    if not isinstance(cfg_data, dict):
        raise die(f"invalid JSON: {config}")

    if not deps:
        # dict preserves deps.json declaration order (jq keys_unsorted), so an
        # author can place a manifest-extracting dep before an iteration-mode
        # dep that reads it.
        deps = list(cfg_data.keys())

    if not deps:
        raise die(f"no deps defined in {config}")

    work_dir = tempfile.mkdtemp()
    try:
        print(f"{PROG}: fetching {len(deps)} dep(s) for {target}")

        hard_failed = 0
        for dep in deps:
            cfg = cfg_data.get(dep)
            cfg = cfg if isinstance(cfg, dict) else {}
            if not process_dep(dep, cfg, if_missing, target, work_dir):
                if is_soft_dep(cfg, soft):
                    print(
                        f"{PROG}: ⚠ {dep} failed; continuing (soft mode)",
                        file=sys.stderr,
                    )
                else:
                    hard_failed += 1

        if hard_failed > 0:
            raise die(f"{hard_failed} dep(s) failed")
    finally:
        shutil.rmtree(work_dir, ignore_errors=True)

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Die as e:
        sys.exit(e.code)

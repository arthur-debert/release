#!/usr/bin/env bash
set -euo pipefail

# release-cut — canonical "cut a release" CLI for the rust-cli + cargo-
# workspace consumers across arthur-debert/* and lex-fmt/* fleets.
#
# Everything runs in CI. This script just figures out the new version
# locally (so you can see "Bumping minor: 1.4.2 -> 1.5.0" before
# committing to it) and dispatches the release workflow.
#
# Usage:
#   release-cut <new-version>          # e.g. release-cut 1.8.0
#   release-cut <bump-level>           # e.g. release-cut minor
#                                      #   (one of: major, minor, patch)
#
# Pre-releases: pass a semver pre-release suffix to cut an RC or beta,
# e.g. `release-cut 1.8.0-rc.1`. CI marks the GitHub Release as
# "pre-release" (so it isn't shown as Latest) and skips rolling
# `## [Unreleased]` in CHANGELOG.md, so subsequent RCs / the final
# release can still draw from the same unreleased entries.
#
# What CI does is per-consumer (see your repo's
# `.github/workflows/release.yml` thin caller of one of
# `arthur-debert/release`'s reusable release workflows: `rust-cli.yml`,
# `tauri-app.yml`, `electron-app.yml`, etc.). At minimum CI bumps
# version files, rolls CHANGELOG, commits + tags, builds, and creates
# the GitHub Release. Per-stack add-ons (crates.io publish, Homebrew
# formula push, .deb packages, codesigning) are wired in the workflow.
#
# Preconditions (checked by CI before mutating anything):
#   - version is MAJOR.MINOR.PATCH[-PRERELEASE]
#   - tag vX.Y.Z does not already exist
#   - version differs from the manifest's current version
#   - CHANGELOG.md has entries under `## [Unreleased]`
#
# After dispatch:
#   gh run watch
#   gh run list --workflow=release.yml --limit=1
#
# Per-repo overrides (env vars; usually unset):
#   RELEASE_CUT_MANIFEST   path to manifest holding current version
#                          (default: <repo-root>/Cargo.toml)
#   RELEASE_CUT_WORKFLOW   workflow file name dispatched via gh
#                          (default: release.yml)

self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SEMVER="$self_dir/../templates/commons/bin/share/semver-tool/semver"

usage() {
    cat <<EOF >&2
usage: $(basename "$0") <major|minor|patch|X.Y.Z[-PRERELEASE]>

Bump shortcuts operate on the current MAJOR.MINOR.PATCH (any
pre-release suffix is stripped before bumping; to step from
1.0.0-rc.1 to 1.0.0, type the version literally).
EOF
}

if [ $# -ne 1 ]; then
    usage
    exit 2
fi
case "$1" in
    -h|--help) usage; exit 0 ;;
esac

arg="$1"
repo_root=$(git rev-parse --show-toplevel)
manifest="${RELEASE_CUT_MANIFEST:-$repo_root/Cargo.toml}"
workflow="${RELEASE_CUT_WORKFLOW:-release.yml}"

# Graceful no-op for Consumers that don't ship a release workflow
# (github-action repos, tree-sitter standalone grammars, etc.). The
# canonical bin/release shim lands in every Consumer via release-sync;
# not every Kind has something to dispatch.
if [ ! -f "$repo_root/.github/workflows/$workflow" ]; then
    echo "release-cut: no .github/workflows/$workflow in this repo; nothing to do."
    exit 0
fi

if [ ! -f "$manifest" ]; then
    echo "release-cut: manifest not found: $manifest" >&2
    echo "  (override with RELEASE_CUT_MANIFEST=<path>)" >&2
    exit 1
fi

case "$arg" in
    major|minor|patch)
        # Reads the first `version = "..."` line — works for
        # `[workspace.package]` at repo-root Cargo.toml (the canonical
        # shape across our fleet), single-crate Cargo.toml, or any
        # other [tool.foo] section that puts version first. Tolerates
        # leading indentation. `|| true` so a no-match doesn't trip
        # `set -e` before the explicit empty check below.
        current=$(grep -E '^[[:space:]]*version[[:space:]]*=[[:space:]]*"' "$manifest" \
            | head -1 \
            | sed -E 's/^[[:space:]]*version[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/') || true
        if [ -z "$current" ]; then
            echo "release-cut: couldn't parse current version from $manifest" >&2
            exit 1
        fi
        new_version="$("$SEMVER" bump "$arg" "$current")"
        echo "Bumping ${arg}: ${current} -> ${new_version}"
        ;;
    *)
        if [[ "$arg" =~ ^[vV] ]] \
            || [[ "$("$SEMVER" validate "$arg")" != "valid" ]] \
            || [[ -n "$("$SEMVER" get build "$arg")" ]]; then
            echo "release-cut: version must be MAJOR.MINOR.PATCH[-PRERELEASE] or one of: major, minor, patch (got: $arg)" >&2
            exit 2
        fi
        new_version="$arg"
        ;;
esac

if ! command -v gh >/dev/null 2>&1; then
    echo "release-cut: gh CLI not found — install from https://cli.github.com/" >&2
    exit 1
fi

echo "Triggering ${workflow} for v${new_version}..."
gh workflow run "$workflow" -f version="$new_version"

cat <<EOF

Workflow queued. Follow with:
  gh run watch
  gh run list --workflow="${workflow}" --limit=1
EOF

#!/usr/bin/env python3
# release-cut — canonical "cut a release" CLI across every Kind.
#
# Thin shim (shell→Python migration, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. release-cut is a
# release-only tool (a real file in bin/, NOT synced to consumers — the
# distributed templates/commons/bin/release shim execs whatever release-cut is
# on $PATH), so realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core (the contract's variant (b)). Stdout,
# exit codes, and the `gh workflow run` dispatch match the old bash byte-for-byte.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import release_cut  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(release_cut.main(sys.argv[1:]))

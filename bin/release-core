#!/usr/bin/env python3
# release-core — the top-level release tooling CLI (pip-bootstrap PoC §2).
#
# Thin shim (shell→Python): run the IN-CHECKOUT release_core package (so a dev
# editing it sees changes immediately) by putting it on sys.path and dispatching
# into the CLI entry. release-core is a release-owned tool (a real file in bin/,
# the contract's variant (b)), so realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core. The installed console-script
# (pyproject [project.scripts] release-core = release_core.cli_entry:main, owned
# by PR-B) runs the SAME main(); this shim is the local-checkout entry.
#
# Dependency provisioning (release#497/#498, venv-first since #867):
# release_core has real third-party deps — `click` today (#457), plus LAZY
# extras like PyJWT imported deep inside verbs (review/ghauth.py). Since #487
# the boot resolver installs them into an ISOLATED venv
# (${XDG_DATA_HOME}/release-core/venv), NOT the --user site — so they're not
# importable by this shim's bare interpreter. Re-execing only on a TOP-LEVEL
# ModuleNotFoundError missed the lazy imports (#867: a bare interpreter with
# click but no PyJWT stayed bare and GitHub-App review requests failed), so the
# shim now prefers the venv OUTRIGHT: whenever the venv python exists (and we
# are not already under it / have not already re-exec'd — the one-shot
# _RELEASE_CORE_REEXEC guard), re-exec under it BEFORE importing anything, with
# PYTHONPATH pinned to the checkout lib so we still run the IN-CHECKOUT code,
# not the wheel installed in the venv. With no venv to borrow deps from we run
# in place, and a missing third-party dep degrades to an actionable hint naming
# the module instead of a raw traceback. A missing `release_core` itself is a
# real bug (not a dep gap) and is left to surface.
import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
_LIB = os.path.join(_HERE, "..", "templates", "commons", "lib", "release_core")
# Fleet verbs reached via `release-core admin repos|release …` resolve their
# default manifest / RELEASE_HOME from a *_SCRIPT_DIR env var pointing at this
# bin/ dir (so resolution is cwd-independent):
#   MANAGED_REPOS_SCRIPT_DIR  → managed_repos: bin/../managed-repos.yaml
#   AUDIT_PORTFOLIO_SCRIPT_DIR → audit_portfolio: bin/../managed-repos.yaml
#   VERIFY_FLEET_SCRIPT_DIR    → release_verify_fleet: RELEASE_HOME = bin/..
# Each was exported by its now-retired flat shim (#468). The release-core shim
# is the on-PATH entry now, so it must export all three — otherwise the verbs
# fall back to cwd (managed-repos.yaml) or the WRONG ~/release default for
# RELEASE_HOME.
os.environ.setdefault("MANAGED_REPOS_SCRIPT_DIR", _HERE)
os.environ.setdefault("AUDIT_PORTFOLIO_SCRIPT_DIR", _HERE)
os.environ.setdefault("VERIFY_FLEET_SCRIPT_DIR", _HERE)

# release#747 — export the checkout lib on PYTHONPATH so re-invoked children
# inherit it. Fleet verbs (verify / canary run / cut) shell out to the engine
# as `<interpreter> -m release_core` (_SELF_CLI). Under the installed wheel the
# interpreter can import release_core; under THIS dev shim it can't — the
# in-process import below uses `sys.path.insert`, which a freshly-spawned child
# does not inherit. Exporting PYTHONPATH (lib FIRST, so children also run the
# IN-CHECKOUT code, not a wheel) closes that gap on the normal deps-present path
# (the venv re-exec path in _reexec_under_venv already sets it for ITS child).
os.environ["PYTHONPATH"] = os.pathsep.join(
    [os.path.realpath(_LIB)] + ([os.environ["PYTHONPATH"]] if os.environ.get("PYTHONPATH") else [])
)

# release#749 — default RELEASE_HOME to the checkout root so `release-core init`
# has a template source. The in-checkout release_core package carries no
# _bundled_templates (those are staged into the wheel only), so a bundle-less
# init would die "no bundled templates and $RELEASE_HOME='' is not a git clone".
# bin/ sits at the checkout root, which IS a git clone with templates/ — point
# init's GitSource at it. setdefault: an explicit RELEASE_HOME still wins.
os.environ.setdefault("RELEASE_HOME", os.path.realpath(os.path.join(_HERE, "..")))


def _release_core_venv_python():
    """Path to the isolated release-core venv's python, mirroring the resolver's
    VENV_DIR computation (install-release-core): ``$RELEASE_CORE_HOME/venv`` when
    set, else ``${XDG_DATA_HOME:-~/.local/share}/release-core/venv``."""
    home = os.environ.get("RELEASE_CORE_HOME") or os.path.join(
        os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share"),
        "release-core",
    )
    return os.path.join(home, "venv", "bin", "python")


def _dep_hint_and_exit(dep):
    """Print an actionable hint naming the missing dep and exit non-zero, instead
    of a raw ModuleNotFoundError traceback."""
    sys.stderr.write(
        f"release-core: missing dependency '{dep}'. The CLI's runtime deps "
        "live in an isolated venv provisioned by the boot resolver. Run "
        "`bin/install-release-core` (or let your repo's SessionStart setup "
        "run it) to provision them, then retry.\n"
    )
    sys.exit(1)


def _maybe_reexec_into_venv():
    """Venv-first interpreter selection (release#867): if the isolated venv
    exists, ALWAYS re-exec under its python before importing anything — a
    top-level-import probe misses LAZY deps (PyJWT inside review/ghauth.py), so
    dep presence on the bare interpreter is no reason to stay on it. Returns
    (runs in place) only when re-exec is impossible or pointless: already
    re-exec'd once (the _RELEASE_CORE_REEXEC one-shot guard — no loop is
    possible), no venv python to exec, or already running inside the venv.
    Never returns on the re-exec path."""
    if os.environ.get("_RELEASE_CORE_REEXEC") == "1":
        return  # one-shot guard: never re-exec twice
    venv_py = _release_core_venv_python()
    if not os.access(venv_py, os.X_OK):
        return  # no venv to borrow deps from — run in place
    # Are we ALREADY running inside that venv? Compare sys.prefix to the venv dir
    # — NOT realpath(venv_py) vs sys.executable: a venv's bin/python is a symlink
    # to the SAME base interpreter binary, so a realpath compare is always equal
    # and would wrongly skip the re-exec (the venv differs by site-packages, not
    # by binary). sys.prefix is the venv dir only when running under it.
    venv_dir = os.path.dirname(os.path.dirname(venv_py))  # …/release-core/venv
    if os.path.realpath(sys.prefix) == os.path.realpath(venv_dir):
        return  # already the venv interpreter — nothing to gain
    env = dict(os.environ)
    env["_RELEASE_CORE_REEXEC"] = "1"
    # PYTHONPATH already leads with the checkout lib (exported at module load,
    # release#747), so the venv python imports the IN-CHECKOUT release_core, not
    # the wheel installed inside the venv — inherited as-is, no re-prepend.
    os.execve(venv_py, [venv_py, os.path.realpath(__file__), *sys.argv[1:]], env)


_maybe_reexec_into_venv()

sys.path.insert(0, _LIB)

try:
    from release_core.cli_entry import main  # noqa: E402 — sys.path set above
except ModuleNotFoundError as exc:  # pragma: no cover - exercised via bats
    # `release_core` itself missing is a real bug, not a dep gap, so let it
    # surface unchanged. For a missing third-party dep: the venv-first re-exec
    # above already fired whenever a venv was usable, so reaching here means
    # there is nothing left to borrow from (no venv / already re-exec'd once /
    # already inside the venv) — degrade to the actionable hint, never loop.
    _top = (exc.name or "").split(".")[0]
    if not _top or _top == "release_core":
        raise
    _dep_hint_and_exit(_top)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

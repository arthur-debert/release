#!/usr/bin/env python3
# release-core — the top-level release tooling CLI (pip-bootstrap PoC §2).
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch into the CLI entry.
# release-core is a release-owned tool (a real file in bin/, the contract's
# variant (b)), so realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core. The installed console-script
# (pyproject [project.scripts] release-core = release_core.cli_entry:main, owned
# by PR-B) runs the SAME main(); this shim is the local-checkout entry.
import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
# Fleet verbs reached via `release-core admin repos|release …` (managed-repos,
# audit-portfolio, release-verify-fleet) resolve the default manifest at
# bin/../managed-repos.yaml from MANAGED_REPOS_SCRIPT_DIR. The flat
# `managed-repos` shim used to export this; now that the flat names are retired
# (#468) the release-core shim is the on-PATH entry, so it must export it too —
# otherwise the manifest default only resolves when cwd happens to be the
# release clone root.
os.environ.setdefault("MANAGED_REPOS_SCRIPT_DIR", _HERE)
sys.path.insert(
    0,
    os.path.join(_HERE, "..", "templates", "commons", "lib", "release_core"),
)

from release_core.cli_entry import main  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

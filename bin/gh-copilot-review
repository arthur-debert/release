#!/usr/bin/env bash
# Request a Copilot review, wait for it, then print the review + comments.
#
# Usage:
#   gh-copilot-review <pr-number>
#
# Composite of gh-copilot-on + gh-copilot-wait + a review-printing step.
# Use when you want to drive a single PR end-to-end through Copilot review
# in one foreground command. For parallel/background use, call the
# individual scripts.
#
# Output:
#   - "=== copilot review on <repo>#<pr> ===" — review state + body
#   - "=== inline comments ===" — file:line + comment body, one per line
#
# Exit codes:
#   0  — review printed
#   2  — gh-copilot-wait timed out
#   64 — bad usage
#
# Example:
#   gh-copilot-review 91

set -euo pipefail

show_help() { sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; }

case "${1:-}" in
  -h|--help) show_help; exit 0 ;;
  '') show_help >&2; exit 64 ;;
esac

pr=$1
[[ "$pr" =~ ^[0-9]+$ ]] || { echo "error: PR number must be numeric (got: $pr)" >&2; exit 64; }

dir=$(cd "$(dirname "$0")" && pwd)
"$dir/gh-copilot-on" "$pr"
"$dir/gh-copilot-wait" "$pr"

repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)

echo
echo "=== copilot review on $repo#$pr ==="
gh api "repos/{owner}/{repo}/pulls/$pr/reviews" \
  --jq '.[] | select(.user.login == "copilot-pull-request-reviewer[bot]") | "\nstate: \(.state)\nsubmitted: \(.submitted_at)\n\n\(.body)\n"'

echo "=== inline comments ==="
gh api --paginate "repos/{owner}/{repo}/pulls/$pr/comments" \
  --jq '.[] | select(.user.login == "copilot-pull-request-reviewer[bot]") | "[\(.path):\(.line // .original_line // "?")] \(.body)\n"'

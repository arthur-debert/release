#!/usr/bin/env bash
# Request a Copilot review, wait for it, then print the review + comments.
#
# Usage:
#   gh-copilot-review <pr-number>
#
# Composite of gh-copilot-on + gh-copilot-wait + gh-copilot-show. This
# RE-REQUESTS a review and BLOCKS (~7m initial wait) until it lands. To just
# READ an already-posted review without requesting or waiting, use
# gh-copilot-show instead. For parallel/background use, call the individual
# scripts.
#
# Output:
#   - "=== copilot review on <repo>#<pr> ===" — review state + body
#   - "=== review threads ===" — every review thread (any author, via GraphQL
#     reviewThreads): [open|resolved] file:line, thread/comment ids, bodies
#
# Exit codes:
#   0  — review printed
#   2  — gh-copilot-wait timed out
#   64 — bad usage
#
# Example:
#   gh-copilot-review 91

set -euo pipefail

show_help() { sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; }

case "${1:-}" in
  -h|--help) show_help; exit 0 ;;
  '') show_help >&2; exit 64 ;;
esac

pr=$1
[[ "$pr" =~ ^[0-9]+$ ]] || { echo "error: PR number must be numeric (got: $pr)" >&2; exit 64; }

dir=$(cd "$(dirname "$0")" && pwd)
"$dir/gh-copilot-on" "$pr"
"$dir/gh-copilot-wait" "$pr"

# Print the now-posted review. gh-copilot-show is the read-only path, reused
# here so the print format lives in exactly one place.
"$dir/gh-copilot-show" "$pr"

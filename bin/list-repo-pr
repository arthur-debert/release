#!/usr/bin/env python3
# list-repo-pr — for each managed repo, list open PRs with status info.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. list-repo-pr is a
# release-only tool (a real file in bin/, NOT synced to consumers), so realpath
# lands in bin/ and the package sits at ../templates/commons/lib/release_core
# (the contract's variant (b)). The columnar/ANSI dashboard matches the old bash.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import list_repo_pr  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(list_repo_pr.main(sys.argv[1:]))

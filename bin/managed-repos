#!/usr/bin/env python3
# managed-repos — accessor for the portfolio fleet manifest.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. managed-repos is a
# release-only tool (a real file in bin/, NOT synced to consumers), so realpath
# lands in bin/ and the package sits at ../templates/commons/lib/release_core
# (the contract's variant (b)). Output (the <TAB>-joined --paths/--list lines)
# matches the old bash byte-for-byte — release-verify-fleet/audit-portfolio
# parse it. We export the script's own bin/ dir so the verb resolves the default
# manifest at bin/../managed-repos.yaml exactly as the bash did.
import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
os.environ.setdefault("MANAGED_REPOS_SCRIPT_DIR", _HERE)
sys.path.insert(
    0,
    os.path.join(_HERE, "..", "templates", "commons", "lib", "release_core"),
)

from release_core.verbs import managed_repos  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(managed_repos.main(sys.argv[1:]))

#!/usr/bin/env bash
# Sync managed files from the release repo into the current consumer repo
# using the build-directory + symlinks model (ADR-0001).
#
# Usage:
#   release-sync-next            # rebuild .release/ and symlinks
#   release-sync-next --check    # exit non-zero if anything would change
#   release-sync-next --dry-run  # show what would happen, write nothing
#
# How it works:
#   1. Detect Kind (currently via detect-stack; will rename in PR 2)
#   2. Resolve Capabilities (Kind manifest + consumer .release-sync.yaml)
#   3. Materialize ALL managed files into .release/ from scratch
#   4. For each file in .release/, ensure a relative symlink exists at
#      the expected consumer location (path-mirror: strip template prefix)
#   5. Walk the repo for broken symlinks pointing into .release/ and
#      delete them
#
# No state file. The filesystem is the state. Removals propagate
# automatically because .release/ is rebuilt from scratch.
#
# Source ref selection (first match wins):
#   $RELEASE_REF if set
#   origin/release/beta/<consumer-repo-name>
#   origin/release/beta/<kind>
#   origin/main
#
# Exit codes:
#   0  — clean (sync mode: rebuilt; check mode: no changes needed)
#   1  — changes detected (--check only) or fatal error
#   64 — bad usage

set -euo pipefail

show_help() { sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; }

mode=sync
while [ $# -gt 0 ]; do
  case "$1" in
    --check) mode=check; shift ;;
    --dry-run) mode=dryrun; shift ;;
    -h|--help) show_help; exit 0 ;;
    *) echo "unknown arg: $1" >&2; show_help >&2; exit 64 ;;
  esac
done

RELEASE_HOME=${RELEASE_HOME:-$HOME/release}
if [ ! -d "$RELEASE_HOME/.git" ]; then
  echo "release-sync-next: \$RELEASE_HOME='$RELEASE_HOME' is not a git clone" >&2
  exit 1
fi
command -v yq >/dev/null || {
  echo "release-sync-next: yq is required (mikefarah/yq v4)." >&2
  exit 1
}

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "release-sync-next: not inside a git repo" >&2; exit 1; }
cd "$repo_root"

release_real=$(cd "$RELEASE_HOME" && pwd -P)
repo_real=$(pwd -P)
if [ "$release_real" = "$repo_real" ]; then
  echo "release-sync-next: refusing to run inside \$RELEASE_HOME" >&2
  exit 1
fi

repo_name=$(basename "$repo_root")
kind=$(detect-stack)

# --- Ref selection -------------------------------------------------------

ref=""
if [ -n "${RELEASE_REF:-}" ]; then
  if ! git -C "$RELEASE_HOME" rev-parse --verify --quiet "$RELEASE_REF" >/dev/null; then
    echo "release-sync-next: \$RELEASE_REF='$RELEASE_REF' is not a valid ref" >&2
    exit 1
  fi
  ref=$RELEASE_REF
else
  git -C "$RELEASE_HOME" fetch --quiet --prune origin
  for candidate in "release/beta/$repo_name" "release/beta/$kind" main; do
    if git -C "$RELEASE_HOME" rev-parse --verify --quiet \
         "refs/remotes/origin/$candidate" >/dev/null; then
      ref="origin/$candidate"
      break
    fi
  done
  if [ -z "$ref" ]; then
    echo "release-sync-next: no candidate branch found in \$RELEASE_HOME" >&2
    exit 1
  fi
fi

ref_sha=$(git -C "$RELEASE_HOME" rev-parse "$ref")

if ! git -C "$RELEASE_HOME" ls-tree -d --name-only "$ref" -- "templates/$kind" \
     | grep -q .; then
  echo "release-sync-next: ref '$ref' has no templates/$kind/ tree" >&2
  exit 1
fi

# --- Capability resolution ----------------------------------------------

declare -a capabilities=()
if [ -f .release-sync.yaml ]; then
  manifest_source=".release-sync.yaml (consumer override)"
  mapfile -t capabilities < <(yq '.components // [] | .[]' .release-sync.yaml)
else
  manifest_source="templates/$kind/manifest.yaml (Kind default)"
  if ! git -C "$RELEASE_HOME" cat-file -e "$ref:templates/$kind/manifest.yaml" 2>/dev/null; then
    echo "release-sync-next: ref '$ref' has no templates/$kind/manifest.yaml" >&2
    exit 1
  fi
  mapfile -t capabilities < <(git -C "$RELEASE_HOME" show "$ref:templates/$kind/manifest.yaml" | yq '.components // [] | .[]')
fi

for c in "${capabilities[@]}"; do
  [ -n "$c" ] || continue
  if ! git -C "$RELEASE_HOME" ls-tree -d --name-only "$ref" -- "templates/components/$c" \
       | grep -q .; then
    echo "release-sync-next: declared Capability '$c' has no templates/components/$c/ tree in $ref" >&2
    exit 1
  fi
done

echo "repo:         $repo_name"
echo "kind:         $kind"
echo "ref:          $ref ($ref_sha)"
echo "manifest:     $manifest_source"
echo "capabilities: ${capabilities[*]:-(none)}"
echo

# --- Plan ----------------------------------------------------------------

# Subtrees in low-to-high precedence: commons < each capability < kind
declare -a subtrees=("templates/commons")
for c in "${capabilities[@]}"; do
  [ -n "$c" ] || continue
  subtrees+=("templates/components/$c")
done
subtrees+=("templates/$kind")

should_skip_source() {
  case "$1" in
    */lefthook.fragment.yaml) return 0 ;;
    */manifest.yaml) return 0 ;;
    templates/components/_*) return 0 ;;
    *.DS_Store) return 0 ;;
  esac
  return 1
}

# Map every source path → (file_mode, destination relative to .release/).
# Last write wins (mirrors current release-sync precedence).
declare -A plan_mode=()
declare -A plan_source=()
declare -a plan_order=()

for st in "${subtrees[@]}"; do
  while IFS=$'\t' read -r meta rel; do
    [ -n "$rel" ] || continue
    should_skip_source "$rel" && continue
    file_mode=${meta%% *}
    dest=${rel#"$st"/}
    if [ -z "${plan_source[$dest]:-}" ]; then
      plan_order+=("$dest")
    fi
    plan_mode[$dest]=$file_mode
    plan_source[$dest]=$rel
  done < <(git -C "$RELEASE_HOME" ls-tree -r "$ref" -- "$st" 2>/dev/null || true)
done

# Compose lefthook.yml — this is a generated file, doesn't come from a single source path.
declare -a lefthook_frags=()
if git -C "$RELEASE_HOME" cat-file -e "$ref:templates/components/_lefthook-base.yaml" 2>/dev/null; then
  lefthook_frags+=("templates/components/_lefthook-base.yaml")
fi
for c in "${capabilities[@]}"; do
  [ -n "$c" ] || continue
  fpath="templates/components/$c/lefthook.fragment.yaml"
  if git -C "$RELEASE_HOME" cat-file -e "$ref:$fpath" 2>/dev/null; then
    lefthook_frags+=("$fpath")
  fi
done
stack_frag="templates/$kind/lefthook.fragment.yaml"
if git -C "$RELEASE_HOME" cat-file -e "$ref:$stack_frag" 2>/dev/null; then
  lefthook_frags+=("$stack_frag")
fi

# --- Build the new .release/ tree in a tempdir -------------------------

tmp_release=$(mktemp -d)
trap 'rm -rf "$tmp_release"' EXIT

for dest in "${plan_order[@]}"; do
  src=${plan_source[$dest]}
  mode=${plan_mode[$dest]}
  out="$tmp_release/$dest"
  mkdir -p "$(dirname "$out")"
  git -C "$RELEASE_HOME" show "$ref:$src" > "$out"
  if [ "$mode" = "100755" ]; then chmod 755 "$out"; else chmod 644 "$out"; fi
done

# Generate lefthook.yml if we have fragments
if [ ${#lefthook_frags[@]} -gt 0 ]; then
  frag_tmp=$(mktemp -d)
  i=0
  declare -a frag_files=()
  for fp in "${lefthook_frags[@]}"; do
    out="$frag_tmp/$(printf '%02d' $i)-$(basename "$(dirname "$fp")").yaml"
    git -C "$RELEASE_HOME" show "$ref:$fp" > "$out"
    frag_files+=("$out")
    i=$((i + 1))
  done
  lefthook_out="$tmp_release/lefthook.yml"
  {
    printf '# Generated by release-sync-next from arthur-debert/release@%s. Do not edit.\n' "${ref_sha:0:12}"
    printf '# Regenerate by running release-sync-next.\n\n'
    # shellcheck disable=SC2016
    yq eval-all '. as $i ireduce({}; . *+ $i) | ... comments=""' "${frag_files[@]}"
  } > "$lefthook_out"
  rm -rf "$frag_tmp"
fi

# --- Compute changes ----------------------------------------------------

# Collect all relative paths in the new tree
declare -a new_files=()
while IFS= read -r -d '' f; do
  rel=${f#"$tmp_release"/}
  new_files+=("$rel")
done < <(find "$tmp_release" -type f -print0)

# Collect all relative paths in the existing .release/ (if any)
declare -a old_files=()
if [ -d .release ]; then
  while IFS= read -r -d '' f; do
    rel=${f#.release/}
    old_files+=("$rel")
  done < <(find .release -type f -print0)
fi

# Changes: files added, modified, or removed in .release/
declare -a added=() modified=() removed=()
declare -A new_set=()
for f in "${new_files[@]}"; do new_set[$f]=1; done
declare -A old_set=()
for f in "${old_files[@]}"; do old_set[$f]=1; done

for f in "${new_files[@]}"; do
  if [ -z "${old_set[$f]:-}" ]; then
    added+=("$f")
  elif ! cmp -s "$tmp_release/$f" ".release/$f"; then
    modified+=("$f")
  fi
done
for f in "${old_files[@]}"; do
  if [ -z "${new_set[$f]:-}" ]; then
    removed+=("$f")
  fi
done

# Symlink changes: which new files need a symlink created
declare -a symlinks_to_create=()
declare -a symlinks_to_remove=()
declare -a conflicts=()

for f in "${new_files[@]}"; do
  target=".release/$f"
  # Compute relative path from $f's location to .release/$f
  link_dir=$(dirname "$f")
  if [ "$link_dir" = "." ]; then
    link_target=".release/$f"
  else
    # Count depth of link_dir, each level needs ../
    depth=$(echo "$link_dir" | tr -cd '/' | wc -c)
    depth=$((depth + 1))
    prefix=""
    for ((i=0; i<depth; i++)); do prefix="../$prefix"; done
    link_target="${prefix}.release/$f"
  fi

  if [ -L "$f" ]; then
    current=$(readlink "$f")
    if [ "$current" != "$link_target" ]; then
      symlinks_to_create+=("$f -> $link_target")
    fi
  elif [ -e "$f" ]; then
    conflicts+=("$f")
  else
    symlinks_to_create+=("$f -> $link_target")
  fi
done

# Find broken symlinks pointing into .release/ across the repo.
# Exclude .release/ itself — its contents are real files we just wrote.
while IFS= read -r -d '' link; do
  target=$(readlink "$link")
  case "$target" in
    *.release/*)
      if [ ! -e "$link" ]; then
        symlinks_to_remove+=("$link")
      fi
      ;;
  esac
done < <(find . -type l -not -path './.git/*' -not -path './.release/*' -print0 2>/dev/null)

# --- Report -------------------------------------------------------------

echo "=== .release/ changes ==="
for f in "${added[@]}"; do echo "  +file     $f"; done
for f in "${modified[@]}"; do echo "  ~file     $f"; done
for f in "${removed[@]}"; do echo "  -file     $f"; done

echo
echo "=== symlink changes ==="
for s in "${symlinks_to_create[@]}"; do echo "  +link     $s"; done
for s in "${symlinks_to_remove[@]}"; do echo "  -link     $s (broken)"; done

if [ ${#conflicts[@]} -gt 0 ]; then
  echo
  echo "=== conflicts (real file at managed location — symlink NOT created) ==="
  for f in "${conflicts[@]}"; do echo "  !file     $f"; done
  echo
  echo "Resolve by removing the real file, then re-running sync."
fi

total_changes=$((${#added[@]} + ${#modified[@]} + ${#removed[@]} + ${#symlinks_to_create[@]} + ${#symlinks_to_remove[@]}))
echo
echo "summary: $total_changes changes, ${#conflicts[@]} conflicts"

if [ "$mode" = check ]; then
  [ "$total_changes" -eq 0 ]
  exit
fi

if [ "$mode" = dryrun ]; then
  exit 0
fi

# --- Apply --------------------------------------------------------------

# Replace .release/ atomically: build new tree alongside, swap.
if [ -d .release ]; then rm -rf .release; fi
mv "$tmp_release" .release
trap - EXIT

# Create / update symlinks
for s in "${symlinks_to_create[@]}"; do
  link=${s%% -> *}
  target=${s##* -> }
  mkdir -p "$(dirname "$link")"
  [ -L "$link" ] && rm "$link"
  ln -s "$target" "$link"
done

# Remove broken symlinks
for link in "${symlinks_to_remove[@]}"; do
  rm "$link"
done

echo
echo "done."

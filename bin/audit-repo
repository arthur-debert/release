#!/usr/bin/env bash
# Audit a single repo against the portfolio "good state" baseline.
#
# Usage:
#   audit-repo                       # current git/gh repo
#   audit-repo --repo owner/name
#   audit-repo --json                # machine-readable
#   audit-repo --quiet               # only print failing/warning rows
#
# Exit codes:
#   0  — all checks pass
#   1  — at least one check failed
#   2  — at least one check warned (no fails)
#   64 — bad usage
#
# Each check returns one of: PASS, FAIL, WARN, SKIP. Skips are for
# checks that don't apply (e.g. private-module auth on a repo with no
# go.mod). Warns are findings worth surfacing but not necessarily
# blocking (e.g. dependabot.yml missing entirely vs. having an
# off-policy ecosystem).
#
# Checks performed:
#   1. ruleset           — main-branch-protection ruleset present
#   2. release_token     — RELEASE_TOKEN secret set
#   3. copilot_review    — .github/workflows/copilot-review.yml on default branch
#   4. codeowners        — .github/CODEOWNERS on default branch
#   5. dep_security      — Dependabot vulnerability-alerts enabled
#   6. dep_policy        — .github/dependabot.yml respects portfolio policy
#                          (no npm/cargo/pip/etc. ecosystem; github-actions only)
#   7. ci_main_green     — most recent default-branch CI run succeeded
#   8. private_mod_auth  — if go.mod has private arthur-debert/* deps, workflows
#                          configure git insteadOf with RELEASE_TOKEN
#
# Conformance checks (WARN-only — don't fail; surface adoption gaps):
#   9. release_sync       — .release-sync-state.yaml present (Component-model
#                            adoption signal)
#  10. scripts_inventory  — what's left in scripts/ beyond the canonical
#                            setup-dev-env.sh + project extras
#  11. workflows_canonical — count of workflows that are NOT thin callers of
#                            arthur-debert/release/* (legacy / bespoke surface)
#  12. ci_calls_bin_check    — does ANY workflow file (typically ci.yml /
#                              test.yml) actually invoke `bin/check`? If not,
#                              the Component-supplied canonical interface is
#                              dead weight on disk — CI bypasses it.
#  13. changelog_handling    — which changelog convention is in use:
#                              fragment-dir (canonical, PASS) / single-file
#                              (WARN, migrate per #201) / two-file (WARN) /
#                              none (WARN) / mixed (FAIL).

set -uo pipefail

repo=""
json_mode=0
quiet=0

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)   repo=$2; shift 2 ;;
    --json)   json_mode=1; shift ;;
    --quiet)  quiet=1; shift ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 64 ;;
  esac
done

if [ -z "$repo" ]; then
  repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) || {
    echo "error: not in a gh-recognized repo and --repo not given" >&2
    exit 64
  }
fi

# Result accumulator: each row is "STATUS|name|message"
results=()

record() {
  results+=("$1|$2|$3")
}

# --- Check 1: ruleset ---
check_ruleset() {
  local rs id
  rs=$(gh api "repos/$repo/rulesets" 2>/dev/null) || { record FAIL ruleset "API error querying rulesets"; return; }
  id=$(jq -r '.[]? | select(.name=="main-branch-protection") | .id' <<<"$rs" 2>/dev/null | head -1)
  if [ -n "$id" ]; then
    record PASS ruleset "id=$id"
  else
    record FAIL ruleset "main-branch-protection ruleset not applied (run apply-ruleset)"
  fi
}

# --- Check 2: RELEASE_TOKEN secret ---
check_release_token() {
  if gh secret list -R "$repo" 2>/dev/null | grep -qE '^RELEASE_TOKEN[[:space:]]'; then
    record PASS release_token "set"
  else
    record FAIL release_token "RELEASE_TOKEN not set (run install-release-token)"
  fi
}

# --- Check 3: copilot-review.yml workflow on default branch ---
# Two sub-checks: file presence + pointer points at the working reusable
# workflow (arthur-debert/release@v1, which uses RELEASE_TOKEN). The old
# pointer (arthur-debert/gh-dagentic@main) silently no-ops because
# GITHUB_TOKEN can't request Copilot reviews.
check_copilot_review() {
  local body
  body=$(gh api "repos/$repo/contents/.github/workflows/copilot-review.yml" --jq .content 2>/dev/null \
         | base64 -d 2>/dev/null) || true
  if [ -z "$body" ]; then
    record FAIL copilot_review ".github/workflows/copilot-review.yml missing on default branch"
    return
  fi
  if printf '%s\n' "$body" | grep -q 'arthur-debert/release/.github/workflows/copilot-review.yml@'; then
    record PASS copilot_review "present, points at release/@v1 (fixed)"
  elif printf '%s\n' "$body" | grep -q 'arthur-debert/gh-dagentic/.github/workflows/copilot-review.yml@'; then
    record FAIL copilot_review "present but points at gh-dagentic (broken — silently no-ops Copilot attach)"
  else
    record WARN copilot_review "present but unknown reusable-workflow pointer"
  fi
}

# --- Check 4: CODEOWNERS on default branch ---
check_codeowners() {
  if gh api "repos/$repo/contents/.github/CODEOWNERS" >/dev/null 2>&1 \
     || gh api "repos/$repo/contents/CODEOWNERS" >/dev/null 2>&1; then
    record PASS codeowners "present"
  else
    record WARN codeowners "CODEOWNERS missing"
  fi
}

# --- Check 5: Dependabot security alerts ---
check_dep_security() {
  local code
  code=$(gh api -i "repos/$repo/vulnerability-alerts" 2>&1 | head -1 | awk '{print $2}')
  if [ "$code" = "204" ]; then
    record PASS dep_security "alerts enabled"
  elif [ "$code" = "404" ]; then
    record FAIL dep_security "alerts disabled (run enable-dependabot-security)"
  else
    record WARN dep_security "unexpected status $code"
  fi
}

# --- Check 6: dependabot.yml policy compliance ---
check_dep_policy() {
  local content
  content=$(gh api "repos/$repo/contents/.github/dependabot.yml" --jq .content 2>/dev/null | base64 -d 2>/dev/null) || true
  if [ -z "$content" ]; then
    record WARN dep_policy "no .github/dependabot.yml (won't get GH Actions freshness)"
    return
  fi
  # Find ecosystems other than github-actions. Per portfolio policy, only
  # github-actions freshness is allowed. App-dep ecosystems (npm, cargo,
  # pip, gomod, etc.) violate the policy.
  local off_policy
  off_policy=$(printf '%s\n' "$content" | grep -E '^[[:space:]]*-[[:space:]]*package-ecosystem:' \
               | grep -vE 'github-actions' | sed -E 's/.*package-ecosystem:[[:space:]]*//' \
               | tr -d '"'"'" | sort -u | tr '\n' ',' | sed 's/,$//')
  if [ -z "$off_policy" ]; then
    record PASS dep_policy "github-actions only"
  else
    record FAIL dep_policy "off-policy ecosystems present: $off_policy"
  fi
}

# --- Check 7: most-recent default-branch CI run was success ---
check_ci_main_green() {
  local default_branch latest
  default_branch=$(gh api "repos/$repo" --jq .default_branch 2>/dev/null)
  [ -z "$default_branch" ] && { record WARN ci_main_green "could not determine default branch"; return; }
  # Look at non-copilot-review runs (those don't gate). Take the most recent
  # push event on default branch.
  latest=$(gh api "repos/$repo/actions/runs?branch=$default_branch&event=push&per_page=20" \
           --jq '[.workflow_runs[] | select(.name != "Copilot Review")][0] | {conclusion, name, html_url}' 2>/dev/null)
  if [ -z "$latest" ] || [ "$latest" = "null" ]; then
    record WARN ci_main_green "no push runs found on $default_branch"
    return
  fi
  local conclusion name
  conclusion=$(jq -r .conclusion <<<"$latest")
  name=$(jq -r .name <<<"$latest")
  case "$conclusion" in
    success)   record PASS ci_main_green "latest '$name' run on $default_branch: success" ;;
    failure)   record FAIL ci_main_green "latest '$name' run on $default_branch: failure (CI broken on main)" ;;
    cancelled) record WARN ci_main_green "latest '$name' run on $default_branch: cancelled" ;;
    *)         record WARN ci_main_green "latest '$name' run on $default_branch: $conclusion" ;;
  esac
}

# --- Check 8: private go module auth in CI ---
check_private_mod_auth() {
  local gomod
  gomod=$(gh api "repos/$repo/contents/go.mod" --jq .content 2>/dev/null | base64 -d 2>/dev/null) || true
  if [ -z "$gomod" ]; then
    record SKIP private_mod_auth "no go.mod"
    return
  fi
  # Check whether go.mod requires arthur-debert/* deps that might be private.
  # Skip the `module github.com/arthur-debert/X` line — that's the repo's own
  # module declaration, not a dependency. Real deps appear inside `require (...)`
  # blocks or single-line `require github.com/...` statements.
  local refs
  refs=$(printf '%s\n' "$gomod" | grep -vE '^\s*module\s+' \
         | grep -E '^\s*(require\s+)?github\.com/arthur-debert/' | head -5)
  if [ -z "$refs" ]; then
    record SKIP private_mod_auth "no arthur-debert/* go deps"
    return
  fi
  # Scan all workflow files on default branch for git insteadOf+RELEASE_TOKEN.
  local files has_auth=0
  files=$(gh api "repos/$repo/contents/.github/workflows" --jq '.[]?.name' 2>/dev/null) || true
  for f in $files; do
    [ "$f" = "copilot-review.yml" ] && continue
    local body
    body=$(gh api "repos/$repo/contents/.github/workflows/$f" --jq .content 2>/dev/null | base64 -d 2>/dev/null) || continue
    if printf '%s\n' "$body" | grep -qE 'insteadOf.*github\.com' \
       && printf '%s\n' "$body" | grep -q 'RELEASE_TOKEN'; then
      has_auth=1
      break
    fi
  done
  if [ "$has_auth" = "1" ]; then
    record PASS private_mod_auth "git insteadOf+RELEASE_TOKEN configured"
  else
    record FAIL private_mod_auth "arthur-debert/* deps in go.mod but no insteadOf+RELEASE_TOKEN in workflows"
  fi
}

# --- Conformance check 9: release_sync state ---
# `.release-sync-state.yaml` is dropped by the take-iii `release-sync`
# script when a consumer adopts the Component model. Its presence
# (independent of freshness) is the cleanest single signal of
# Component-model adoption.
check_release_sync() {
  local body
  body=$(gh api "repos/$repo/contents/.release-sync-state.yaml" --jq .content 2>/dev/null | base64 -d 2>/dev/null)
  if [ -z "$body" ]; then
    record WARN release_sync "no .release-sync-state.yaml — Component model not adopted"
    return
  fi
  local sha
  sha=$(printf '%s\n' "$body" | grep -E '^sha:' | head -1 | awk '{print $2}')
  local components
  components=$(printf '%s\n' "$body" | awk '/^components:/{flag=1;next} /^[a-z_]+:/{flag=0} flag && /^ *- /{gsub(/^ *- /,""); print}' | paste -sd, -)
  record PASS release_sync "adopted (sha=${sha:0:7}, components: ${components:-none})"
}

# --- Conformance check 10: scripts inventory ---
# Canonical layout: `scripts/setup-dev-env.sh` only. Other files in
# scripts/ are either legacy (`pre-commit`, `ci.sh`, `check`) that
# should migrate to `bin/`, or project-specific extras that are fine
# but worth surfacing. WARN with the inventory; don't FAIL.
check_scripts_inventory() {
  local listing
  # `if type == "array"` guards against gh api returning an error object
  # (`{"message":"Not Found"}`) when scripts/ doesn't exist on this repo's
  # default branch — without the guard, `.[]?` iterates the object's
  # values and select(.type) trips on the string body.
  listing=$(gh api "repos/$repo/contents/scripts" 2>/dev/null \
    | jq -r 'if type == "array" then .[] | select(.type=="file") | .name else empty end')
  if [ -z "$listing" ]; then
    record SKIP scripts_inventory "no scripts/ dir on default branch"
    return
  fi
  local extras
  # Canonical scripts/ contents: setup-dev-env.sh only.
  extras=$(printf '%s\n' "$listing" | grep -v '^setup-dev-env\.sh$' | paste -sd, -)
  if [ -z "$extras" ]; then
    record PASS scripts_inventory "only setup-dev-env.sh (canonical)"
  else
    record WARN scripts_inventory "non-canonical: ${extras}"
  fi
}

# --- Conformance check 11: workflows canonicality ---
# A "canonical" workflow either calls a release/ reusable workflow
# (`uses: arthur-debert/release/.github/workflows/...`), or IS the
# release-synced `copilot-review.yml` thin caller. Bespoke workflows
# (full inline jobs that don't delegate to release/) are surfaced as
# the conformance gap.
check_workflows_canonical() {
  local listing
  # Same array-vs-error-object guard as check_scripts_inventory.
  listing=$(gh api "repos/$repo/contents/.github/workflows" 2>/dev/null \
    | jq -r 'if type == "array" then .[] | select(.type=="file") | .name else empty end')
  if [ -z "$listing" ]; then
    record SKIP workflows_canonical "no .github/workflows/ on default branch"
    return
  fi
  local canonical=0 bespoke_list="" total=0
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    total=$((total+1))
    local body
    body=$(gh api "repos/$repo/contents/.github/workflows/$f" --jq .content 2>/dev/null | base64 -d 2>/dev/null)
    if printf '%s\n' "$body" | grep -qE 'uses:.*arthur-debert/release/\.github/workflows/'; then
      canonical=$((canonical+1))
    else
      bespoke_list+="${f}, "
    fi
  done <<<"$listing"
  bespoke_list=${bespoke_list%, }
  if [ -z "$bespoke_list" ]; then
    record PASS workflows_canonical "all $total workflows are thin callers of release/"
  else
    record WARN workflows_canonical "$canonical/$total canonical; bespoke: ${bespoke_list}"
  fi
}

# --- Conformance check 12: CI calls bin/check ---
# Component model ships `bin/check` as the canonical local+CI umbrella.
# If the consumer has release_sync adoption (.release-sync-state.yaml)
# but NO workflow file actually runs `bin/check`, the canonical
# interface is dead weight — CI duplicates the invocation inline
# (worse: silently diverges over time). Surfaces the CI workflow
# reusability gap per-repo.
check_ci_calls_bin_check() {
  # Only meaningful if Component-model adoption has happened. Skip otherwise.
  local sync_body
  sync_body=$(gh api "repos/$repo/contents/.release-sync-state.yaml" --jq .content 2>/dev/null | base64 -d 2>/dev/null)
  if [ -z "$sync_body" ]; then
    record SKIP ci_calls_bin_check "no Component model — N/A"
    return
  fi
  local listing
  listing=$(gh api "repos/$repo/contents/.github/workflows" 2>/dev/null \
    | jq -r 'if type == "array" then .[] | select(.type=="file") | .name else empty end')
  if [ -z "$listing" ]; then
    record SKIP ci_calls_bin_check "no .github/workflows/"
    return
  fi
  # Canonical reusable workflows in release/ that internally invoke
  # bin/check (or its Component-supplied siblings like bin/check-e2e
  # via the bats integration). If a consumer thin-calls one of these,
  # the canonical interface IS being exercised — even though the
  # literal `run: bin/check` string lives in the callee, not the
  # caller. Keep this list in sync as new <stack>-ci.yml workflows ship.
  local canonical_callees='arthur-debert/release/\.github/workflows/(rust-ci|go-ci|electron-ci|tauri-ci|bats-e2e|mkdocs)\.yml'
  local found="" via_reusable=""
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    local body
    body=$(gh api "repos/$repo/contents/.github/workflows/$f" --jq .content 2>/dev/null | base64 -d 2>/dev/null)
    # (a) Direct `run: bin/check` (umbrella) or `run: bin/check-e2e` etc.
    # Excludes `bin/check-fmt` invoked alone — those are atomic Tasks
    # the umbrella composes.
    if printf '%s\n' "$body" | grep -qE '^[[:space:]]*run:[[:space:]]*bin/check([[:space:]]|$)'; then
      found="$found, $f"
    # (b) Thin-caller of a canonical release/ reusable that runs bin/check
    # internally. Same semantics — the canonical interface is exercised.
    elif printf '%s\n' "$body" | grep -qE "uses:[[:space:]]*${canonical_callees}"; then
      via_reusable="$via_reusable, $f"
    fi
  done <<<"$listing"
  found=${found#, }
  via_reusable=${via_reusable#, }
  if [ -n "$found" ] && [ -n "$via_reusable" ]; then
    record PASS ci_calls_bin_check "direct: $found; via reusable: $via_reusable"
  elif [ -n "$found" ]; then
    record PASS ci_calls_bin_check "called in: $found"
  elif [ -n "$via_reusable" ]; then
    record PASS ci_calls_bin_check "via release/ reusable workflow in: $via_reusable"
  else
    record WARN ci_calls_bin_check "Component model adopted but no workflow calls bin/check (CI duplicates invocation)"
  fi
}

# --- Check 13: changelog convention ---
check_changelog_handling() {
  # Map the repo onto one of the proposal's variants:
  #   fragment-dir  (canonical, PASS)
  #   single-file   (## Unreleased in CHANGELOG.md, WARN — migrate per #201)
  #   two-file      (CHANGELOG_UNRELEASED.md present, WARN)
  #   none          (no CHANGELOG.md or CHANGELOG/ dir, WARN)
  #   mixed         (more than one of the above, FAIL — needs cleanup)
  local has_dir=0 has_block=0 has_two_file=0

  local dir_listing
  dir_listing=$(gh api "repos/$repo/contents/CHANGELOG" 2>/dev/null)
  if [ -n "$dir_listing" ] \
      && [ "$(printf '%s' "$dir_listing" | jq -r 'type' 2>/dev/null)" = "array" ]; then
    has_dir=1
  fi

  local body
  body=$(gh api "repos/$repo/contents/CHANGELOG.md" --jq .content 2>/dev/null \
         | base64 -d 2>/dev/null)
  if [ -n "$body" ] && printf '%s\n' "$body" | grep -qE '^##[[:space:]]+\[?Unreleased\]?'; then
    has_block=1
  fi

  if gh api "repos/$repo/contents/CHANGELOG_UNRELEASED.md" >/dev/null 2>&1; then
    has_two_file=1
  fi

  local active=$((has_dir + has_block + has_two_file))
  if [ "$active" -gt 1 ]; then
    local present=""
    [ "$has_dir" = 1 ]      && present="$present fragment-dir"
    [ "$has_block" = 1 ]    && present="$present single-file"
    [ "$has_two_file" = 1 ] && present="$present two-file"
    record FAIL changelog_handling "mixed conventions:${present} — pick one (#201)"
  elif [ "$has_dir" = 1 ]; then
    record PASS changelog_handling "fragment-dir (canonical)"
  elif [ "$has_block" = 1 ]; then
    record WARN changelog_handling "single-file (## Unreleased) — migrate per #201"
  elif [ "$has_two_file" = 1 ]; then
    record WARN changelog_handling "two-file (CHANGELOG_UNRELEASED.md) — migrate per #201"
  else
    record WARN changelog_handling "none — no CHANGELOG.md or CHANGELOG/ found"
  fi
}

# Run all checks
check_ruleset
check_release_token
check_copilot_review
check_codeowners
check_dep_security
check_dep_policy
check_ci_main_green
check_private_mod_auth
check_release_sync
check_scripts_inventory
check_workflows_canonical
check_ci_calls_bin_check
check_changelog_handling

# --- Output ---
if [ "$json_mode" = "1" ]; then
  printf '{"repo":"%s","checks":[' "$repo"
  first=1
  for r in "${results[@]}"; do
    IFS='|' read -r status name msg <<<"$r"
    [ "$first" = 0 ] && printf ','
    first=0
    printf '{"name":"%s","status":"%s","message":"%s"}' \
      "$name" "$status" "$(printf '%s' "$msg" | sed 's/"/\\"/g')"
  done
  printf ']}\n'
else
  printf '%s\n' "$repo"
  for r in "${results[@]}"; do
    IFS='|' read -r status name msg <<<"$r"
    if [ "$quiet" = "1" ] && [ "$status" = "PASS" ]; then continue; fi
    if [ "$quiet" = "1" ] && [ "$status" = "SKIP" ]; then continue; fi
    printf '  [%-4s] %-20s %s\n' "$status" "$name" "$msg"
  done
fi

# Exit code
fails=0
warns=0
for r in "${results[@]}"; do
  IFS='|' read -r status _ _ <<<"$r"
  case "$status" in
    FAIL) fails=$((fails+1)) ;;
    WARN) warns=$((warns+1)) ;;
  esac
done

if [ "$fails" -gt 0 ]; then exit 1; fi
if [ "$warns" -gt 0 ]; then exit 2; fi
exit 0

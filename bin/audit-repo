#!/usr/bin/env python3
# audit-repo — audit a single repo against the portfolio "good state" baseline.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. audit-repo is a
# release-only tool (a real file in bin/, NOT synced to consumers), so realpath
# lands in bin/ and the package sits at ../templates/commons/lib/release_core
# (the contract's variant (b)). The --json shape and exit codes match the old
# bash byte-for-byte; audit-portfolio aggregates this verb's results.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import audit_repo  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(audit_repo.main(sys.argv[1:]))

#!/usr/bin/env bash
# orc — the fleet orchestrator CLI (propagate, watch, …), resolved through the
# uv workspace.
#
# Why a wrapper: orchestrator depends on `release_gh` as a uv *workspace* member
# (resolved from the repo root, not installed into the orchestrator subdir venv).
# So a bare `orchestrator/.venv/bin/orc` fails at import with
# `ModuleNotFoundError: No module named 'release_gh'`. Going through
# `uv run --project <release>/orchestrator` resolves the workspace every time, so
# `orc` Just Works regardless of which .venv happens to be synced.
#
# release-DEV tool: it operates the fleet FROM release (opens consumer PRs, etc.).
# It is NOT synced to consumers — lives only in repo-root bin/ (on PATH via dodot).
set -euo pipefail

# Repo root = parent of this script's bin/ dir. bin/orc is a real file on PATH
# (release/bin is exported directly, not symlink-mirrored), so $0 is its real
# path and dirname/.. is the release checkout.
_root="$(cd "$(dirname "$0")/.." && pwd)"

if ! command -v uv >/dev/null 2>&1; then
  echo "orc: 'uv' is required (orchestrator resolves release_gh via the uv workspace). Install uv, then re-run." >&2
  exit 1
fi

exec uv run --project "${_root}/orchestrator" orc "$@"

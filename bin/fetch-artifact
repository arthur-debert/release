#!/usr/bin/env python3
# fetch-artifact — install a pinned cross-repo artifact from a GH release.
#
# Reads artifacts.json (canonical schema; see docs/artifacts-schema.md)
# and downloads the named artifact at the pinned version.
#
# Usage:
#   fetch-artifact <name> [options]
#
# Options:
#   --manifest <path>   Path to artifacts.json (default: ./artifacts.json)
#   --target <dir>      Install dir (default: $HOME/.local/bin)
#   --arch <triple>     Override host arch detection (e.g. for cross-fetch)
#   --no-cache          Force re-download even if stamp matches
#   -h | --help         Print this help and exit
#
# Behavior summary:
#   - Reads pin entry for <name> from the manifest.
#   - Resolves {arch} → host's rust-target-triple (see docs/artifacts-schema.md).
#   - `gh release download` into a temp dir, extracts.
#   - Resolves install shape: explicit `type: binary|tree` field wins; else
#     auto-detect by looking for an executable file whose name matches <name>.
#   - binary: move to <target>/<name>, chmod 0755, stamp <target>/.<name>.version
#   - tree:   extract under <target>/<name>/, stamp <target>/<name>/.version
#   - Idempotent: if stamp file matches manifest version, exit 0 with no work.
#
# Exit codes:
#   0  installed (or already up-to-date)
#   1  generic error (manifest missing, dep missing, etc.)
#   2  artifact name not in manifest
#   3  host arch unsupported by this artifact
#   4  download or extract failed
#
# Source of truth: arthur-debert/release bin/fetch-artifact.
#
# Self-contained, stdlib-only Python (shell→Python port). It is fetched standalone via
# raw.githubusercontent.com and run with no `release_core` present, so it
# imports nothing beyond the stdlib and shells out to `gh`/`tar`/`unzip`
# for network + extraction (matching the old bash byte-for-byte). The
# manifest is parsed with `json` — `jq` is no longer required.
"""fetch-artifact — install a pinned cross-repo artifact from a GH release."""

from __future__ import annotations

import json
import os
import platform
import shutil
import subprocess
import sys
import tempfile

VERSION = "2026-05-18-v1"


# Exit-code-carrying error so the body can `raise Fail(n, msg)` and the
# top-level wrapper renders it exactly like the old `err; exit n`.
class Fail(Exception):
    def __init__(self, code: int, msg: str) -> None:
        super().__init__(msg)
        self.code = code
        self.msg = msg


def err(msg: str) -> None:
    print(f"fetch-artifact: error: {msg}", file=sys.stderr)


def warn(msg: str) -> None:
    print(f"fetch-artifact: warning: {msg}", file=sys.stderr)


USAGE = """\
fetch-artifact — install a pinned cross-repo artifact from a GH release.

Reads artifacts.json (canonical schema; see docs/artifacts-schema.md)
and downloads the named artifact at the pinned version.

Usage:
  fetch-artifact <name> [options]

Options:
  --manifest <path>   Path to artifacts.json (default: ./artifacts.json)
  --target <dir>      Install dir (default: $HOME/.local/bin)
  --arch <triple>     Override host arch detection (e.g. for cross-fetch)
  --no-cache          Force re-download even if stamp matches
  -h | --help         Print this help and exit
"""


def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def resolve_arch(arch_override: str) -> str:
    if arch_override:
        return arch_override
    sys_name = platform.system()
    mach = platform.machine()
    key = f"{sys_name}:{mach}"
    table = {
        "Linux:x86_64": "x86_64-unknown-linux-gnu",
        "Linux:AMD64": "x86_64-unknown-linux-gnu",
        "Linux:aarch64": "aarch64-unknown-linux-gnu",
        "Linux:arm64": "aarch64-unknown-linux-gnu",
        "Darwin:x86_64": "x86_64-apple-darwin",
        "Darwin:arm64": "aarch64-apple-darwin",
        "Darwin:aarch64": "aarch64-apple-darwin",
    }
    if key in table:
        return table[key]
    # Windows: platform.system() == "Windows"; map the two known arches.
    if sys_name in ("Windows",) or sys_name.startswith(("MINGW", "MSYS", "CYGWIN")):
        if mach in ("x86_64", "AMD64"):
            return "x86_64-pc-windows-msvc"
        if mach in ("aarch64", "arm64", "ARM64"):
            return "aarch64-pc-windows-msvc"
    raise Fail(3, f"unsupported host: {sys_name} {mach}")


def find_executable_named(root: str, name: str) -> str | None:
    """First executable (u+x) regular file named <name> under root."""
    for dirpath, _dirs, files in os.walk(root):
        _dirs.sort()  # deterministic descent order across platforms
        for f in sorted(files):
            if f != name:
                continue
            p = os.path.join(dirpath, f)
            if os.path.isfile(p) and (os.stat(p).st_mode & 0o100):
                return p
    return None


def find_first_executable(root: str) -> str | None:
    for dirpath, _dirs, files in os.walk(root):
        _dirs.sort()  # deterministic descent order across platforms
        for f in sorted(files):
            p = os.path.join(dirpath, f)
            if os.path.isfile(p) and (os.stat(p).st_mode & 0o100):
                return p
    return None


def extract_archive(archive: str, dest: str) -> None:
    os.makedirs(dest, exist_ok=True)
    low = archive.lower()
    try:
        if low.endswith((".tar.gz", ".tgz")):
            if subprocess.run(["tar", "-xzf", archive, "-C", dest]).returncode != 0:
                raise Fail(4, "tar extract failed")
        elif low.endswith(".zip"):
            if not have("unzip"):
                raise Fail(1, "unzip needed for .zip archives")
            if subprocess.run(["unzip", "-q", archive, "-d", dest]).returncode != 0:
                raise Fail(4, "unzip failed")
        else:
            raise Fail(4, f"unsupported archive type: {archive}")
    except FileNotFoundError:
        cmd = "tar" if low.endswith((".tar.gz", ".tgz")) else "unzip"
        raise Fail(1, f"required command not found: {cmd}") from None


def run(argv: list[str]) -> int:
    name = ""
    manifest = ""
    target = ""
    arch_override = ""
    no_cache = False

    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(USAGE, end="")
            return 0
        elif a == "--version":
            print(f"fetch-artifact {VERSION}")
            return 0
        elif a == "--manifest":
            manifest = argv[i + 1]
            i += 2
        elif a == "--target":
            target = argv[i + 1]
            i += 2
        elif a == "--arch":
            arch_override = argv[i + 1]
            i += 2
        elif a == "--no-cache":
            no_cache = True
            i += 1
        elif a == "--":
            i += 1
            break
        elif a.startswith("-"):
            err(f"unknown flag: {a}")
            return 1
        else:
            if not name:
                name = a
                i += 1
            else:
                err(f"unexpected positional argument: {a}")
                return 1

    if not name:
        err("missing required argument: <name>")
        print(USAGE, end="", file=sys.stderr)
        return 1

    manifest = manifest or "./artifacts.json"
    target = target or os.path.join(os.path.expanduser("~"), ".local", "bin")

    # --- deps ---
    for cmd in ("gh", "tar"):
        if not have(cmd):
            err(f"required command not found: {cmd}")
            return 1

    if not os.path.isfile(manifest):
        err(f"manifest not found: {manifest}")
        return 1

    # --- read manifest entry ---
    try:
        with open(manifest, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        err(f'artifact "{name}" not in manifest {manifest}')
        return 2
    if not isinstance(data, dict) or name not in data or data[name] is None:
        err(f'artifact "{name}" not in manifest {manifest}')
        return 2

    entry = data[name]
    entry = entry if isinstance(entry, dict) else {}
    version_pin = str(entry.get("version") or "")
    repo = str(entry.get("repo") or "")
    asset_pattern = str(entry.get("asset") or "")
    type_declared = str(entry.get("type") or "")

    for field_name, val in (("version", version_pin), ("repo", repo)):
        if not val:
            err(f"{manifest}:{name}: missing required field {field_name}")
            return 1

    # --- arch resolution ---
    arch = resolve_arch(arch_override)

    # --- compute asset name ---
    if not asset_pattern:
        asset_pattern = f"{name}-{{arch}}.tar.gz"
    asset = asset_pattern.replace("{arch}", arch)

    # --- idempotency: stamp check ---
    stamp_bin = os.path.join(target, f".{name}.version")
    stamp_tree = os.path.join(target, name, ".version")

    if not no_cache:
        for stamp in (stamp_bin, stamp_tree):
            if os.path.isfile(stamp):
                try:
                    with open(stamp, encoding="utf-8") as fh:
                        # bash compared via $(cat …), which strips the
                        # trailing newline the stamp is written with.
                        recorded = fh.read().rstrip("\n")
                except OSError:
                    recorded = ""
                if recorded == version_pin:
                    print(f"fetch-artifact: {name} {version_pin} already installed ({stamp})")
                    return 0

    # --- download ---
    os.makedirs(target, exist_ok=True)
    tmp = tempfile.mkdtemp()
    try:
        print(f"fetch-artifact: downloading {name} {version_pin} ({repo} → {asset}) ...")
        dl = subprocess.run(
            [
                "gh",
                "release",
                "download",
                version_pin,
                "--repo",
                repo,
                "--pattern",
                asset,
                "--dir",
                tmp,
                "--clobber",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if dl.returncode != 0:
            err(f"download failed: {repo}@{version_pin} pattern={asset}")
            return 4

        archive_path = os.path.join(tmp, asset)
        if not os.path.isfile(archive_path):
            # gh may strip the dir prefix or rename — fall back to the only
            # file in TMP (top level only).
            candidates = [
                os.path.join(tmp, e)
                for e in sorted(os.listdir(tmp))
                if os.path.isfile(os.path.join(tmp, e))
            ]
            archive_path = candidates[0] if candidates else ""
        if not archive_path or not os.path.isfile(archive_path):
            err(f"expected archive missing after download: {asset}")
            return 4

        # --- extract ---
        extract = os.path.join(tmp, "extract")
        os.makedirs(extract, exist_ok=True)
        extract_archive(archive_path, extract)

        # --- resolve install shape ---
        artifact_type = type_declared
        if not artifact_type:
            artifact_type = "binary" if find_executable_named(extract, name) else "tree"

        # --- install ---
        if artifact_type == "binary":
            bin_src = find_executable_named(extract, name)
            if not bin_src:
                # Fall back to the first executable file in the archive (e.g.
                # when the binary is named differently than the artifact key).
                bin_src = find_first_executable(extract)
            if not bin_src:
                err("no executable file found in archive for binary install")
                return 4
            dest = os.path.join(target, name)
            shutil.copyfile(bin_src, dest)
            os.chmod(dest, 0o755)
            with open(stamp_bin, "w", encoding="utf-8") as fh:
                fh.write(version_pin + "\n")
            print(f"fetch-artifact: installed {name} {version_pin} → {dest}")
        elif artifact_type == "tree":
            dest = os.path.join(target, name)
            shutil.rmtree(dest, ignore_errors=True)
            os.makedirs(dest, exist_ok=True)
            # Detect single-top-level-dir tarballs (the GH convention) and
            # unwrap. Glob semantics: ignore dotfile entries, like bash `*`.
            top = [e for e in sorted(os.listdir(extract)) if not e.startswith(".")]
            single_top = None
            for e in top:
                p = os.path.join(extract, e)
                if os.path.isdir(p):
                    single_top = p
                    break
            if len(top) == 1 and single_top:
                shutil.copytree(single_top, dest, dirs_exist_ok=True)
            else:
                shutil.copytree(extract, dest, dirs_exist_ok=True)
            os.makedirs(os.path.dirname(stamp_tree), exist_ok=True)
            with open(stamp_tree, "w", encoding="utf-8") as fh:
                fh.write(version_pin + "\n")
            print(f"fetch-artifact: installed {name} {version_pin} → {dest}/")
        else:
            err(f"unknown type: {artifact_type} (must be 'binary' or 'tree')")
            return 1
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    return 0


def main() -> int:
    try:
        return run(sys.argv[1:])
    except Fail as f:
        err(f.msg)
        return f.code


if __name__ == "__main__":
    sys.exit(main())

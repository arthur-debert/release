#!/usr/bin/env python3
# release-notify-source — close the feedback loop on a consumer-filed issue.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. release-notify-source
# is a release-only tool (a real file in bin/, NOT synced to consumers), so
# realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core (the contract's variant (b)). The
# dry-run/--post/--close gating and every stdout/stderr line match the old bash.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import release_notify_source  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(release_notify_source.main(sys.argv[1:]))

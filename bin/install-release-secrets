#!/usr/bin/env bash
# Install rust-cli release secrets across every onboarded rust repo.
#
# Why: the `arthur-debert/release` rust-cli reusable workflow needs 7 GH
# secrets to do its job (Apple sign+notarize, crates.io publish, Homebrew
# tap push). This script propagates them from canonical local sources so
# onboarding a new project — or rotating secrets across all projects —
# is a single command. Companion to `install-release-token` (which
# handles RELEASE_TOKEN separately).
#
# Sources:
#   APPLE_CERTIFICATE_P12_BASE64  = base64(~/h/dotfiles/apple/auth/developerID_application.p12)
#   APPLE_CERTIFICATE_PASSWORD    = cat ~/h/dotfiles/apple/auth/p12_password.txt
#   ASC_API_KEY_BASE64            = base64(~/h/dotfiles/apple/auth/AuthKey_*.p8)
#   ASC_API_KEY_ID                = parsed from p8 filename
#   ASC_API_ISSUER_ID             = cat ~/h/dotfiles/apple/auth/asc_issuer_id.txt
#   CRATES_IO_KEY                 = $CRATES_IO_KEY (env)
#   HOMEBREW_TAP_TOKEN            = $HOMEBREW_TAP_TOKEN (env)
#
# Usage:
#   install-release-secrets                          # auto-discover rust repos
#   install-release-secrets --owners arthur-debert
#   install-release-secrets --repos arthur-debert/dodot,lex-fmt/lex
#   install-release-secrets --dry-run
#
# Discovery: queries every repo under the given owners that has the
# `main-branch-protection` ruleset (same set install-release-token uses),
# then filters to those with Cargo.toml at the repo root.

set -euo pipefail

owners="arthur-debert,lex-fmt"
explicit_repos=""
dry_run=false
auth_dir="${HOME}/h/dotfiles/apple/auth"

while [ $# -gt 0 ]; do
  case "$1" in
    --owners)   owners=$2; shift 2 ;;
    --repos)    explicit_repos=$2; shift 2 ;;
    --auth-dir) auth_dir=$2; shift 2 ;;
    --dry-run)  dry_run=true; shift ;;
    -h|--help)  sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 64 ;;
  esac
done

# ─── Source: Apple cert ────────────────────────────────────────────────────
p12_file="$auth_dir/developerID_application.p12"
p12_password_file="$auth_dir/p12_password.txt"
[ -f "$p12_file" ] || { echo "missing: $p12_file" >&2; exit 1; }
if [ ! -f "$p12_password_file" ]; then
  cat >&2 <<EOF
missing: $p12_password_file

This file should contain the password for $p12_file on a single line.
If lost, re-pack the cert with a fresh hex password:

  openssl pkcs12 -legacy -in <source.p12> -out /tmp/cert.pem -nodes
  PW=\$(openssl rand -hex 16)
  openssl pkcs12 -legacy -export -in /tmp/cert.pem -out $p12_file -password pass:\$PW
  printf '%s' "\$PW" > $p12_password_file
  chmod 600 $p12_password_file
  rm /tmp/cert.pem

…then re-run this script. Note: re-packing invalidates the password
already set in every consumer repo, so plan to run this after re-pack.
EOF
  exit 1
fi

# ─── Source: ASC API key ───────────────────────────────────────────────────
p8_file=$(ls "$auth_dir"/AuthKey_*.p8 2>/dev/null | head -1)
[ -n "$p8_file" ] || { echo "missing: $auth_dir/AuthKey_*.p8" >&2; exit 1; }
asc_key_id=$(basename "$p8_file" | sed -E 's/^AuthKey_(.+)\.p8$/\1/')

issuer_file="$auth_dir/asc_issuer_id.txt"
[ -f "$issuer_file" ] || { echo "missing: $issuer_file" >&2; exit 1; }

# ─── Source: env-resident tokens ───────────────────────────────────────────
[ -n "${CRATES_IO_KEY-}" ]      || { echo "env CRATES_IO_KEY not set" >&2; exit 1; }
[ -n "${HOMEBREW_TAP_TOKEN-}" ] || { echo "env HOMEBREW_TAP_TOKEN not set" >&2; exit 1; }

# ─── Discovery ─────────────────────────────────────────────────────────────
repos=()
if [ -n "$explicit_repos" ]; then
  IFS=',' read -ra repos <<< "$explicit_repos"
else
  echo "discovering onboarded rust repos in: $owners"
  for owner in $(echo "$owners" | tr ',' ' '); do
    while read -r repo; do
      rs=$(gh api "repos/$repo/rulesets" 2>/dev/null || echo '[]')
      id=$(jq -r '.[]? | select(.name == "main-branch-protection") | .id' <<<"$rs" 2>/dev/null | head -1)
      [ -n "$id" ] || continue
      if gh api "repos/$repo/contents/Cargo.toml" >/dev/null 2>&1; then
        repos+=("$repo")
      fi
    done < <(gh repo list "$owner" --limit 200 --json nameWithOwner --jq '.[].nameWithOwner')
  done
fi

if [ ${#repos[@]} -eq 0 ]; then
  echo "no rust repos found" >&2
  exit 1
fi

echo "found ${#repos[@]} repo(s):"
printf '  %s\n' "${repos[@]}"
echo

# ─── Encode + push ─────────────────────────────────────────────────────────
p12_b64=$(base64 -i "$p12_file")
p8_b64=$(base64 -i "$p8_file")
p12_password=$(cat "$p12_password_file")
issuer_id=$(tr -d '\n\r ' < "$issuer_file")

set_secret() {
  local repo=$1 name=$2 value=$3
  if [ "$dry_run" = "true" ]; then
    printf '    [dry] %s\n' "$name"
    return 0
  fi
  if printf '%s' "$value" | gh secret set "$name" -R "$repo" >/dev/null 2>&1; then
    return 0
  fi
  printf '    FAIL %s\n' "$name"
  return 1
}

failed_repos=0
for repo in "${repos[@]}"; do
  printf '  %s\n' "$repo"
  fail=0
  set_secret "$repo" APPLE_CERTIFICATE_P12_BASE64 "$p12_b64"            || fail=$((fail+1))
  set_secret "$repo" APPLE_CERTIFICATE_PASSWORD   "$p12_password"       || fail=$((fail+1))
  set_secret "$repo" ASC_API_KEY_BASE64           "$p8_b64"             || fail=$((fail+1))
  set_secret "$repo" ASC_API_KEY_ID               "$asc_key_id"         || fail=$((fail+1))
  set_secret "$repo" ASC_API_ISSUER_ID            "$issuer_id"          || fail=$((fail+1))
  set_secret "$repo" CRATES_IO_KEY                "$CRATES_IO_KEY"      || fail=$((fail+1))
  set_secret "$repo" HOMEBREW_TAP_TOKEN           "$HOMEBREW_TAP_TOKEN" || fail=$((fail+1))
  [ "$fail" -gt 0 ] && failed_repos=$((failed_repos+1))
done

echo
if [ "$failed_repos" -gt 0 ]; then
  echo "summary: ${#repos[@]} repos, $failed_repos with failures" >&2
  exit 1
fi
echo "summary: ${#repos[@]} repos, all 7 secrets set"

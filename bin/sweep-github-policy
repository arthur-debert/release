#!/usr/bin/env bash
# Drop the canonical .github/ policy files into the current repo, based on
# its detected stack.
#
# Usage:
#   sweep-github-policy [--stack <stack>] [--force]
#
# - Auto-detects stack via detect-stack (override with --stack)
# - For each template file: creates if missing; reports if already present
#   with different content (use --force to overwrite)

set -euo pipefail

stack=""
force=0

while [ $# -gt 0 ]; do
  case "$1" in
    --stack) stack=$2; shift 2 ;;
    --force) force=1; shift ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 64 ;;
  esac
done

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

stack=${stack:-$(detect-stack)}
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
templates="$script_dir/../templates/$stack"
[ -d "$templates" ] || { echo "no templates for stack '$stack' at $templates" >&2; exit 1; }

echo "repo:  $(basename "$repo_root")"
echo "stack: $stack"
echo

created=0
updated=0
skipped=0
conflicts=0

# Map a template-relative path to its destination in the consumer repo.
# Explicit by design: any new template path that doesn't match a documented
# row produces an error rather than a silent .github/ default, so a future
# contributor adding e.g. .gitignore or rustfmt.toml has to make a deliberate
# routing decision. Mirror of the map_dest() in skills/gh-repo-setup/SKILL.md.
map_dest() {
  local rel=$1
  case "$rel" in
    workflows/*)                       printf '.github/%s' "$rel" ;;
    scripts/*)                         printf '%s' "$rel" ;;
    lefthook.yml)                      printf '%s' "$rel" ;;
    CODEOWNERS                 | \
    dependabot.yml             | \
    copilot-instructions.md    | \
    pull_request_template.md)          printf '.github/%s' "$rel" ;;
    *)
      echo "error: no destination mapping for template path '$rel' — add it to map_dest()" >&2
      exit 1 ;;
  esac
}

# Find all files in the template tree, relative to its root.
while IFS= read -r src; do
  rel=${src#"$templates/"}
  # Skip .DS_Store and other macOS artifacts.
  case "$rel" in .DS_Store) continue ;; esac
  dest=$(map_dest "$rel")
  mkdir -p "$(dirname "$dest")"
  if [ ! -e "$dest" ]; then
    cp "$src" "$dest"
    # Preserve executable bit on scripts/ entries.
    case "$rel" in scripts/*) chmod +x "$dest" ;; esac
    echo "  created   $dest"
    created=$((created + 1))
  elif cmp -s "$src" "$dest"; then
    echo "  ok        $dest"
    skipped=$((skipped + 1))
  elif [ "$force" = 1 ]; then
    cp "$src" "$dest"
    case "$rel" in scripts/*) chmod +x "$dest" ;; esac
    echo "  updated   $dest"
    updated=$((updated + 1))
  else
    echo "  conflict  $dest (differs; --force to overwrite)"
    conflicts=$((conflicts + 1))
  fi
done < <(find "$templates" -type f)

echo
printf 'summary: %d created, %d updated, %d ok, %d conflicts\n' \
  "$created" "$updated" "$skipped" "$conflicts"

[ "$conflicts" -eq 0 ]

#!/usr/bin/env python3
# sweep-github-policy — drop the canonical policy + setup files into a repo.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. sweep-github-policy
# is a release-only tool (a real file in bin/, NOT synced to consumers), so
# realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core (the contract's variant (b)). The
# per-file lines, summary, and conflict→nonzero exit match the old bash.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import sweep_github_policy  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(sweep_github_policy.main(sys.argv[1:]))

#!/usr/bin/env python3
# audit-portfolio — audit every managed repo against the "good state" baseline.
#
# Thin shim (shell→Python, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. audit-portfolio is
# a release-only tool (a real file in bin/, NOT synced to consumers), so
# realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core (the contract's variant (b)). We export
# the script's own bin/ dir so the verb resolves bin/../managed-repos.yaml
# exactly as the bash did. Output (--json stream, summary table) + exit codes
# match the old bash byte-for-byte.
import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
os.environ.setdefault("AUDIT_PORTFOLIO_SCRIPT_DIR", _HERE)
sys.path.insert(
    0,
    os.path.join(_HERE, "..", "templates", "commons", "lib", "release_core"),
)

from release_core.verbs import audit_portfolio  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(audit_portfolio.main(sys.argv[1:]))

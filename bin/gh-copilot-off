#!/usr/bin/env bash
# Remove Copilot as a reviewer (and any pending review request).
#
# Usage:
#   gh-copilot-off <pr-number>
#
# Inverse of gh-copilot-on. Posts a DELETE to the requested_reviewers API
# to drop Copilot from the PR's reviewer list. Useful when a review was
# requested in error, or when re-requesting a fresh review (delete then
# call gh-copilot-on again).
#
# Exit codes:
#   0  — request removed
#   64 — bad usage
#
# Example:
#   gh-copilot-off 91

set -euo pipefail

show_help() { sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; }

case "${1:-}" in
  -h|--help) show_help; exit 0 ;;
  '') show_help >&2; exit 64 ;;
esac

pr=$1
[[ "$pr" =~ ^[0-9]+$ ]] || { echo "error: PR number must be numeric (got: $pr)" >&2; exit 64; }

repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
gh pr edit "$pr" --repo "$repo" --remove-reviewer @copilot >/dev/null
echo "removed copilot review request on $repo#$pr"

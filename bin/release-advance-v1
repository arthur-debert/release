#!/usr/bin/env bash
# Advance the floating v1 branch to the current main (fast-forward only).
#
# Consumers pin `@v1`; this branch must always point at the latest
# non-breaking commit on main. After merging a release-side fix to main,
# run this to publish it to every `@v1` consumer in one step instead of
# the four-command `fetch && checkout v1 && merge --ff-only main && push`
# dance.
#
# Usage:
#   release-advance-v1            # ff v1 -> origin/main, then push
#   release-advance-v1 --dry-run  # show what would happen, push nothing
#   release-advance-v1 <ref>      # ff v1 -> <ref> instead of origin/main
#
# Runs from inside the release repo (or $RELEASE_HOME). It updates the
# remote v1 ref directly via a server-side fast-forward push, so it never
# touches your working tree or current checkout. Refuses if the
# fast-forward is impossible (v1 has commits the target doesn't) — that's
# a divergence signal to resolve by hand.
#
# Exit codes:
#   0  — v1 advanced (or already up to date)
#   1  — fatal error / non-fast-forward
#   64 — bad usage

set -euo pipefail

show_help() { sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'; }

dry_run=0
ref=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=1; shift ;;
    -h|--help) show_help; exit 0 ;;
    -*) echo "unknown arg: $1" >&2; show_help >&2; exit 64 ;;
    *)
      [ -z "$ref" ] || { echo "release-advance-v1: too many args" >&2; exit 64; }
      ref=$1; shift ;;
  esac
done

# Locate the release repo: prefer $RELEASE_HOME, else the current repo.
RELEASE_HOME=${RELEASE_HOME:-$HOME/release}
if [ -d "$RELEASE_HOME/.git" ]; then
  cd "$RELEASE_HOME"
elif git rev-parse --show-toplevel >/dev/null 2>&1; then
  cd "$(git rev-parse --show-toplevel)"
else
  echo "release-advance-v1: not inside the release repo and \$RELEASE_HOME unset" >&2
  exit 1
fi

# Sanity: refuse to push v1 on a repo that isn't arthur-debert/release.
origin_url=$(git remote get-url origin 2>/dev/null || true)
case "$origin_url" in
  *arthur-debert/release*) : ;;
  *) echo "release-advance-v1: origin ('$origin_url') doesn't look like arthur-debert/release; refusing" >&2; exit 1 ;;
esac

git fetch --quiet origin

src=${ref:-origin/main}
target_sha=$(git rev-parse --verify "$src" 2>/dev/null) || {
  echo "release-advance-v1: bad ref '$src'" >&2; exit 1; }

if git rev-parse --verify --quiet origin/v1 >/dev/null; then
  current_v1=$(git rev-parse origin/v1)
  if [ "$current_v1" = "$target_sha" ]; then
    echo "v1 already at $src ($(git rev-parse --short "$target_sha")) — nothing to do."
    exit 0
  fi
  if ! git merge-base --is-ancestor "$current_v1" "$target_sha"; then
    echo "release-advance-v1: v1 ($(git rev-parse --short "$current_v1")) is NOT an ancestor of $src ($(git rev-parse --short "$target_sha"))." >&2
    echo "A fast-forward is impossible — v1 has commits $src doesn't. Resolve by hand." >&2
    exit 1
  fi
  echo "advancing v1: $(git rev-parse --short "$current_v1") -> $(git rev-parse --short "$target_sha") ($src)"
else
  echo "release-advance-v1: origin/v1 doesn't exist yet; creating it at $src ($(git rev-parse --short "$target_sha"))." >&2
fi

if [ "$dry_run" = 1 ]; then
  echo "(dry-run) would: git push origin ${target_sha}:refs/heads/v1"
  exit 0
fi

git push origin "${target_sha}:refs/heads/v1"
echo "v1 -> $(git rev-parse --short "$target_sha")"

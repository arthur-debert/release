#!/usr/bin/env python3
# release-advance-major — fast-forward the floating major branch (vN) to main.
#
# Thin shim (shell→Python migration, docs/proposals/shell-to-python.md): put the
# stdlib-only release_core package on sys.path and dispatch. release-advance-major
# is a release-only tool (a real file in bin/, NOT synced to consumers), so
# realpath lands in bin/ and the package sits at
# ../templates/commons/lib/release_core (the contract's variant (b)). Stdout and
# exit codes match the old bash byte-for-byte.
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "templates",
        "commons",
        "lib",
        "release_core",
    ),
)

from release_core.verbs import release_advance_major  # noqa: E402 — sys.path set above

if __name__ == "__main__":
    sys.exit(release_advance_major.main(sys.argv[1:]))
